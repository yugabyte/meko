  <span class="repo" id="repo"></span>
  <span class="spacer"></span>
  <span class="updated" id="updated"></span>
  <label style="font-size:12px;color:var(--muted)">
    <input type="checkbox" id="auto" checked> auto-refresh
  </label>
  <button onclick="load()">Refresh</button>
</header>
<main>
  <div class="banner" id="banner"></div>
  <section><h2>Services</h2><div class="cards" id="services"></div></section>
  <section>
    <h2>Tenants, Timelines &amp; Endpoints
      <button onclick="createTenant(this)"
        style="margin-left:10px;font-size:11px;padding:2px 8px;cursor:pointer;background:#1e222b;color:#9fb3d1;border:1px solid #2a2f3a;border-radius:4px;vertical-align:middle;"
        title="Create a new tenant and start an endpoint on its main branch">+ tenant</button>
    </h2>
    <div id="unified"></div>
  </section>
</main>
<script>
const $ = (id) => document.getElementById(id);
const esc = (s) => String(s == null ? "" : s).replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
const mono = (s) => `<span class="mono">${esc(s)}</span>`;

function pick(o, keys) {
  for (const k of keys) if (o && o[k] !== undefined && o[k] !== null) return o[k];
  return undefined;
}

function normId(v) {
  return String(v == null ? "" : v).replace(/-/g, "").toLowerCase();
}

function branchCell(branchNames, tenantId, timelineId) {
  const key = normId(tenantId) + "/" + normId(timelineId);
  const name = branchNames[key] || null;
  return name ? `<span class="pill ok">${esc(name)}</span>` : mono('-');
}

function table(headers, rows) {
  if (!rows.length) return `<div class="empty">none</div>`;
  return `<table><thead><tr>${headers.map(h=>`<th>${esc(h)}</th>`).join("")}</tr></thead>
    <tbody>${rows.map(r=>`<tr>${r.map(c=>`<td>${c}</td>`).join("")}</tr>`).join("")}</tbody></table>`;
}

function renderServices(svcs) {
  const show = svcs.filter(s => s.kind !== 'pageserver' && s.kind !== 'safekeeper' && s.kind !== 'endpoint_storage');
  $("services").innerHTML = show.map(s => `
    <div class="card">
      <div class="svc"><span class="dot ${s.up?'up':'down'}"></span>${esc(s.name)}</div>
      <div class="url">${esc(s.url)}</div>
      ${s.up ? '' : `<div class="err">${esc(s.detail||'unreachable')}</div>`}
    </div>`).join("");
}

function buildTlTree(timelines) {
  const byId = {};
  for (const tl of timelines) byId[normId(tl.timeline_id)] = {tl, children: []};
  const roots = [];
  for (const tl of timelines) {
    const anc = tl.ancestor_timeline_id;
    const parent = anc ? byId[normId(anc)] : null;
    if (parent) parent.children.push(byId[normId(tl.timeline_id)]);
    else roots.push(byId[normId(tl.timeline_id)]);
  }
  return roots;
}

function renderTlNode(node, ctx) {
  const {branchNames, tid, epByTl, skByTl, esUrl, esById} = ctx;
  const tl = node.tl;
  const tlid = tl.timeline_id;
  const key = normId(tid) + '/' + normId(tlid);
  const branch = branchNames[key];
  const skHttp = skByTl[key] || null;
  const eps = epByTl[key] || [];

  const branchPill = branch
    ? `<span class="pill branch">${esc(branch)}</span>`
    : `<span class="pill">${mono(tlid.slice(0,8)+'…')}</span>`;

  const portOf = url => url ? url.split(':').pop() : '-';
  const psCell = mono(tl._ps_http ? portOf(tl._ps_http) : '-');
  const skCell = mono(skHttp ? portOf(skHttp) : '-');

  let epSection = '';
  if (eps.length) {
    const rows = eps.map(ep => {
      let cls = 'bad', label = 'stopped';
      if (ep.running) { cls = 'ok'; label = 'running'; }
      else if (ep.compute_ctl_up) { cls = 'warn'; label = 'starting'; }
      // Endpoint storage is per-endpoint (its own port); look it up by
      // endpoint_id, falling back to the cluster-level es_url.
      const epEs = (esById && esById[ep.endpoint_id]) || esUrl;
      const esCell = mono(epEs ? portOf(epEs) : '-');
      return `<tr>
        <td>${esc(ep.endpoint_id)}</td>
        <td><span class="pill ${cls}">${label}</span></td>
        <td>${esc(ep.mode || '-')}</td>
        <td class="mono"><a href="#" onclick="openSqlTool(${ep.pg_port}, '${ep.endpoint_id}');return false;"
          title="Open in SQL tool (localhost:8081)"
          style="color:#7fb0ff;text-decoration:underline;cursor:pointer">127.0.0.1:${esc(ep.pg_port)}</a></td>
        <td class="mono">${esc(ep.external_http_port || '-')}</td>
        <td>${psCell}</td>
        <td>${skCell}</td>
        <td>${esCell}</td>
      </tr>`;
    }).join('');
    epSection = `<table class="ep-table">
      <thead><tr>
        <th>endpoint</th><th>state</th><th>mode</th><th>URL</th><th>pg http</th><th>ps http</th><th>sk http</th><th>es http</th>
      </tr></thead>
      <tbody>${rows}</tbody>
    </table>`;
  }

  const childrenHtml = node.children.length
    ? `<div class="tl-children">${node.children.map(c => renderTlNode(c, ctx)).join('')}</div>`
    : '';

  // Branching uses --ancestor-branch-name, so only offer the button on
  // timelines that actually have a branch name.
  const branchBtn = branch
    ? `<button onclick='createBranch(${JSON.stringify(tid)},${JSON.stringify(branch)},${JSON.stringify(tlid)},this)'
        style="margin-left:10px;font-size:11px;padding:2px 8px;cursor:pointer;background:#1e222b;color:#9fb3d1;border:1px solid #2a2f3a;border-radius:4px;"
        title="Branch off ${esc(branch)} and create + start a new endpoint">+ branch</button>`
    : '';

  // Drop is offered on named branches except `main`: dropping a tenant's root
  // timeline would orphan it. Reddish styling + a confirm() flag the
  // destructive, irreversible-ish action (vs the no-prompt branch create).
  const dropBtn = (branch && branch !== 'main')
    ? `<button onclick='dropBranch(${JSON.stringify(tid)},${JSON.stringify(tlid)},${JSON.stringify(branch)},this)'
        style="margin-left:6px;font-size:11px;padding:2px 8px;cursor:pointer;background:#2b1e22;color:#d99;border:1px solid #3a2a2f;border-radius:4px;"
        title="Drop ${esc(branch)} and all its endpoints">× Delete</button>`
    : '';

  return `<div class="tl-tree-node">
    <div class="tl-block">
      <div class="tl-head">
        ${branchPill} <span class="tl-label">Timeline:</span> ${mono(tlid)}${branchBtn}${dropBtn}
      </div>
      ${epSection}
    </div>
    ${childrenHtml}
  </div>`;
}

// Tenant ids the user has collapsed. Kept across the periodic re-render so a
// collapsed tenant stays collapsed when auto-refresh rebuilds the view.
const collapsedTenants = new Set();

function toggleTenant(tid) {
  const body = document.getElementById('tl-body-' + tid);
  const btn = document.getElementById('tl-toggle-' + tid);
  if (collapsedTenants.has(tid)) {
    collapsedTenants.delete(tid);
    if (body) body.style.display = '';
    if (btn) btn.textContent = '▾';
  } else {
    collapsedTenants.add(tid);
    if (body) body.style.display = 'none';
    if (btn) btn.textContent = '▸';
  }
}

function renderUnified(d) {
  const branchNames = d.topology.branch_names || {};

  // DB-derived mapping covers all timelines including branches; the SK
  // runtime listing only returns timelines it has loaded in memory.
  const skByTl = d.topology.timeline_sk_urls || {};

  const epByTl = {};
  for (const ep of d.endpoints || []) {
    const key = normId(ep.tenant_id) + '/' + normId(ep.timeline_id);
    if (!epByTl[key]) epByTl[key] = [];
    epByTl[key].push(ep);
  }

  if (!d.tenants || !d.tenants.length) {
    $("unified").innerHTML = `<div class="empty">no tenants</div>`;
    return;
  }

  $("unified").innerHTML = (d.tenants || []).map(entry => {
    const tid = pick(entry.tenant, ['id','tenant_id']);
    const state = entry.tenant.state || '?';
    const ctx = {branchNames, tid, epByTl, skByTl, esUrl: d.topology.endpoint_storage,
                 esById: d.topology.endpoint_storage_by_id || {}};
    const roots = buildTlTree(entry.timelines || []);
    const tlsHtml = roots.map(r => renderTlNode(r, ctx)).join('');
    const collapsed = collapsedTenants.has(tid);

    return `<div class="tenant">
      <div class="head">
        <button id="tl-toggle-${esc(tid)}" onclick='toggleTenant(${JSON.stringify(tid)})'
          style="font-size:11px;padding:0 6px;cursor:pointer;background:#1e222b;color:#9fb3d1;border:1px solid #2a2f3a;border-radius:4px;"
          title="Collapse/expand this tenant">${collapsed ? '▸' : '▾'}</button>
        <span class="tl-label">Tenant:</span> <span class="tid">${esc(tid)}</span>
        <span class="pill ${/active/i.test(state)?'ok':'warn'}">${esc(state)}</span>
        <span class="pill">${entry.timelines.length} branches(s)</span>
      </div>
      <div id="tl-body-${esc(tid)}" ${collapsed ? 'style="display:none"' : ''}>${tlsHtml}</div>
    </div>`;
  }).join('');
}

// Open this endpoint's libpq connection in pgweb (localhost:8081).
//
// pgweb's `/open/<connection-string>` route connects to the given URL and drops
// you straight into the query view — no clipboard paste or connect-form fiddling
// needed. The connection string is passed raw in the path (pgweb takes the rest
// of the path, query string included, as the URL).
function openSqlTool(pgPort, endpoint_id) {
  const conn = 'postgresql://cloud_admin@127.0.0.1:' + pgPort + '/postgres?sslmode=disable&name='+ endpoint_id;
  window.open('http://localhost:8081/open/' + conn);
}

async function createBranch(tid, ancestor, ancestorTlid, btn) {
  const old = btn.textContent;
  btn.disabled = true;
  btn.textContent = "…creating";
  try {
    const r = await fetch("/api/branch", {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({tenant_id: tid, ancestor_branch: ancestor,
                            ancestor_timeline_id: ancestorTlid}),
    });
    const d = await r.json();
    // No prompts on success — just refresh and the new branch appears.
    // Surface failures only, so a click that does nothing isn't a mystery.
    if (!(r.ok && d.ok)) {
      const detail = d.error
        || (d.steps || []).map(s => `${s.ok ? "✓" : "✗"} ${s.cmd}\n${s.output}`).join("\n\n");
      alert("Branch creation failed:\n\n" + detail);
    }
  } catch (e) {
    alert("Branch creation failed: " + e);
  } finally {
    btn.disabled = false;
    btn.textContent = old;
    burstRefresh();
  }
}

async function dropBranch(tid, tlid, branch, btn) {
  if (!confirm("Drop branch '" + branch + "' and all its endpoints?\n\n"
      + "This stops its compute(s), deletes their records, and marks the "
      + "timeline dropped. The underlying data is left for a later GC pass.")) {
    return;
  }
  const old = btn.textContent;
  btn.disabled = true;
  btn.textContent = "…dropping";
  try {
    const r = await fetch("/api/drop", {
      method: "POST",
      headers: {"Content-Type": "application/json"},
      body: JSON.stringify({tenant_id: tid, timeline_id: tlid}),
    });
    const d = await r.json();
    // No prompt on success — refresh and the branch disappears. Surface
    // failures only, so a click that does nothing isn't a mystery.
    if (!(r.ok && d.ok)) {
      const detail = d.error
        || (d.steps || []).map(s => `${s.ok ? "✓" : "✗"} ${s.cmd}\n${s.output}`).join("\n\n");
      alert("Branch drop failed:\n\n" + detail);
    }
  } catch (e) {
    alert("Branch drop failed: " + e);
  } finally {
    btn.disabled = false;
    btn.textContent = old;
    burstRefresh();
  }
}

async function createTenant(btn) {
  const old = btn.textContent;
  btn.disabled = true;
  btn.textContent = "…creating";
  try {
    const r = await fetch("/api/tenant", {method: "POST"});
    const d = await r.json();
    // No prompts on success — just refresh and the new tenant appears.
    // Surface failures only, so a click that does nothing isn't a mystery.
    if (!(r.ok && d.ok)) {
      const detail = d.error
        || (d.steps || []).map(s => `${s.ok ? "✓" : "✗"} ${s.cmd}\n${s.output}`).join("\n\n");
      alert("Tenant creation failed:\n\n" + detail);
    }
  } catch (e) {
    alert("Tenant creation failed: " + e);
  } finally {
    btn.disabled = false;
    btn.textContent = old;
    burstRefresh();
  }
}

async function load() {
  try {
    const r = await fetch("/api/data", {cache:"no-store"});
    const d = await r.json();
    $("banner").style.display = "none";
    $("repo").textContent = d.topology.repo_dir;
    renderServices(d.services);
    renderUnified(d);
    $("updated").textContent = "updated " + new Date().toLocaleTimeString();
  } catch (e) {
    $("banner").style.display = "block";
    $("banner").textContent = "Failed to load /api/data: " + e;
  }
}

let timer = null;
let fastRefreshUntil = 0;

// After a mutating action, poll every 1s for 5s so the new branch/endpoint
// shows up promptly (provisioning lags the click), then fall back to 4s. The
// burst refreshes regardless of the auto-refresh checkbox, since the user just
// asked for something and expects to see it appear.
function burstRefresh() {
  fastRefreshUntil = Date.now() + 5000;
  clearTimeout(timer);
  tick();  // load now and start the 1s cadence
}

function tick() {
  const fast = Date.now() < fastRefreshUntil;
  if ($("auto").checked || fast) load();
  timer = setTimeout(tick, fast ? 1000 : 4000);
}
load(); tick();
</script>
</body>
</html>
"""


# --------------------------------------------------------------------------
# Mutating action: branch + endpoint create/start via the yb_light_local CLI.
# --------------------------------------------------------------------------

# Friendly "adjective-noun" names (e.g. "brave-otter") for branches and
# endpoints, instead of opaque random tokens. The two lists give 60 x 60 = 3600
# combinations, so accidental collisions are rare; if one does occur the CLI
# rejects the duplicate name and the failure surfaces in the UI, so a retry
# (which draws a fresh name) fixes it.
_ADJECTIVES = [
    "amber", "bold", "brave", "bright", "calm", "clever", "cosmic", "crisp",
    "daring", "deep", "eager", "early", "fancy", "fast", "gentle", "glad",
    "golden", "happy", "hidden", "humble", "icy", "jolly", "keen", "kind",
    "lively", "loud", "lucky", "lunar", "merry", "mighty", "misty", "neat",
    "noble", "nimble", "polished", "proud", "quick", "quiet", "rapid", "royal",
    "rustic", "sharp", "shiny", "silent", "sleek", "smooth", "snowy", "solar",
    "spry", "steady", "stormy", "sunny", "swift", "tidy", "vivid", "warm",
    "wise", "witty", "young", "zesty",
]
_NOUNS = [
    "otter", "falcon", "maple", "river", "comet", "ember", "harbor", "willow",
    "badger", "cedar", "lynx", "heron", "meadow", "raven", "summit", "thistle",
    "walrus", "beacon", "canyon", "dolphin", "elm", "fjord", "glacier", "hawk",
    "ibis", "juniper", "koala", "lagoon", "marten", "nectar", "oak", "panther",
    "quartz", "robin", "spruce", "tiger", "urchin", "vortex", "wombat", "yak",
    "zephyr", "alder", "bison", "coral", "delta", "eagle", "ferret", "grove",
    "hollow", "island", "jaguar", "kestrel", "lotus", "mesa", "nimbus", "orchid",
    "pine", "reef", "sparrow", "tundra",
]


def english_name():
    """Return a friendly "adjective-noun" identifier, e.g. "brave-otter"."""
    return f"{random.choice(_ADJECTIVES)}-{random.choice(_NOUNS)}"


def create_branch_with_endpoint(repo_dir, tenant_id, ancestor_branch, ancestor_timeline_id):
    """Branch off `ancestor_branch`, then create and start an endpoint on the
    new branch. The new branch and its endpoint share one friendly name.

    yb_light_local resolves `--ancestor-branch-name` through its local branch
    mappings, which can be missing or out of sync with the durable controller
    state. Since the UI already knows the ancestor's timeline id (from the
    controller), we first register that mapping (`mappings map`) so the branch
    resolves regardless. Shells out to the repo's `target/debug/yb_light_local`
    (args passed as a list, never via a shell). Returns
    {ok, branch, endpoint, steps:[{cmd, ok, output}]} or {ok: False, error}.
    """
    if not tenant_id or not re.fullmatch(r"[0-9a-fA-F]{32}", str(tenant_id)):
        return {"ok": False, "error": f"invalid tenant_id {tenant_id!r}"}
    if not ancestor_branch or not re.fullmatch(r"[A-Za-z0-9_.\-]{1,64}", str(ancestor_branch)):
        return {"ok": False, "error": f"invalid ancestor branch {ancestor_branch!r}"}
    if not ancestor_timeline_id or not re.fullmatch(r"[0-9a-fA-F]{32}", str(ancestor_timeline_id)):
        return {"ok": False, "error": f"invalid ancestor timeline id {ancestor_timeline_id!r}"}

    # The CLI operates on the repo (parent of .yb_light) and finds .yb_light
    # relative to its working directory.
    repo_root = os.path.dirname(os.path.abspath(repo_dir)) if repo_dir else os.getcwd()
    binary = os.path.join(repo_root, "target", "debug", "yb_light_local")
    if not os.path.exists(binary):
        return {"ok": False, "error": f"yb_light_local binary not found at {binary}"}

    # The new branch and its endpoint share one friendly name.
    name = english_name()

    def run(args, timeout=180):
        try:
            p = subprocess.run([binary, *args], cwd=repo_root,
                               capture_output=True, text=True, timeout=timeout)
            return p.returncode, (p.stdout + p.stderr).strip()
        except subprocess.TimeoutExpired:
            return 124, "timed out"

    steps = []

    # Best-effort: make sure the ancestor branch name maps to its timeline id.
    # `mappings map` errors if the mapping already exists — that's fine (the
    # mapping is present), so this step is never fatal.
    rc, out = run(["mappings", "map", "--tenant-id", tenant_id,
                   "--timeline-id", ancestor_timeline_id, "--branch-name", ancestor_branch])
    steps.append({"cmd": f"mappings map {ancestor_branch} -> {ancestor_timeline_id}",
                  "ok": True,
                  "output": ("already mapped" if rc != 0 else out) or "mapped"})

    for c in [
        ["timeline", "branch", "--tenant-id", tenant_id,
         "--branch-name", name, "--ancestor-branch-name", ancestor_branch],
        ["endpoint", "create", name, "--tenant-id", tenant_id, "--branch-name", name],
        ["endpoint", "start", name],
    ]:
        rc, out = run(c)
        steps.append({"cmd": " ".join(c), "ok": rc == 0, "output": out[-2000:]})
        if rc != 0:
            return {"ok": False, "branch": name, "endpoint": name, "steps": steps}

    return {"ok": True, "branch": name, "endpoint": name, "steps": steps}


def create_tenant_with_endpoint(repo_dir):
    """Create a fresh tenant, then create and start an endpoint on its `main`
    branch so it's immediately usable. The tenant id is generated by the CLI;
    the endpoint gets a friendly name.

    The main-branch endpoint can't simply be called "main": endpoint ids are
    globally unique across the cluster, so every tenant's "main" would collide.
    It therefore gets its own friendly name (the "non-main endpoint == branch
    name" convention only applies to branches, whose names we control).

    `tenant create` only allocates ids and records the pending bootstrap
    recipe — the tenant's PS+SK pair isn't provisioned until the first endpoint
    is created on the `main` branch (co-located topology), so we do that here to
    mirror the branch flow's "leaves you with a running endpoint" behaviour.
    Shells out to the repo's `target/debug/yb_light_local` (args passed as a
    list, never via a shell). Returns
    {ok, tenant_id, branch, endpoint, steps:[{cmd, ok, output}]} or
    {ok: False, error}.
    """
    repo_root = os.path.dirname(os.path.abspath(repo_dir)) if repo_dir else os.getcwd()
    binary = os.path.join(repo_root, "target", "debug", "yb_light_local")
    if not os.path.exists(binary):
        return {"ok": False, "error": f"yb_light_local binary not found at {binary}"}

    name = english_name()

    def run(args, timeout=180):
        try:
            p = subprocess.run([binary, *args], cwd=repo_root,
                               capture_output=True, text=True, timeout=timeout)
            return p.returncode, (p.stdout + p.stderr).strip()
        except subprocess.TimeoutExpired:
            return 124, "timed out"

    steps = []

    rc, out = run(["tenant", "create"])
    steps.append({"cmd": "tenant create", "ok": rc == 0, "output": out[-2000:]})
    if rc != 0:
        return {"ok": False, "steps": steps}

    # `tenant create` prints "tenant <id> successfully created"; pull the id out
    # so we can attach the endpoint to it.
    m = re.search(r"tenant ([0-9a-fA-F]{32}) successfully created", out)
    if not m:
        return {"ok": False, "error": "could not parse tenant id from output",
                "steps": steps}
    tenant_id = m.group(1)

    for c in [
        ["endpoint", "create", name, "--tenant-id", tenant_id, "--branch-name", "main"],
        ["endpoint", "start", name],
    ]:
        rc, out = run(c)
        steps.append({"cmd": " ".join(c), "ok": rc == 0, "output": out[-2000:]})
        if rc != 0:
            return {"ok": False, "tenant_id": tenant_id, "branch": "main",
                    "endpoint": name, "steps": steps}

    return {"ok": True, "tenant_id": tenant_id, "branch": "main",
            "endpoint": name, "steps": steps}


def drop_branch(repo_dir, tenant_id, timeline_id):
    """Drop a branch and all its endpoints via `yb_light_local timeline drop`:
    stops the branch's endpoint compute(s), deletes their records, and marks
    the timeline dropped in the storage controller (the underlying PS/SK data
    is left for a later GC pass). Shells out to the repo's
    `target/debug/yb_light_local` (args passed as a list, never via a shell).
    Returns {ok, steps:[{cmd, ok, output}]} or {ok: False, error}.
    """
    if not tenant_id or not re.fullmatch(r"[0-9a-fA-F]{32}", str(tenant_id)):
        return {"ok": False, "error": f"invalid tenant_id {tenant_id!r}"}
    if not timeline_id or not re.fullmatch(r"[0-9a-fA-F]{32}", str(timeline_id)):
        return {"ok": False, "error": f"invalid timeline_id {timeline_id!r}"}

    repo_root = os.path.dirname(os.path.abspath(repo_dir)) if repo_dir else os.getcwd()
    binary = os.path.join(repo_root, "target", "debug", "yb_light_local")
    if not os.path.exists(binary):
        return {"ok": False, "error": f"yb_light_local binary not found at {binary}"}

    cmd = ["timeline", "drop", "--tenant-id", tenant_id, "--timeline-id", timeline_id]
    try:
        p = subprocess.run([binary, *cmd], cwd=repo_root,
                           capture_output=True, text=True, timeout=180)
    except subprocess.TimeoutExpired:
        return {"ok": False,
                "steps": [{"cmd": " ".join(cmd), "ok": False, "output": "timed out"}]}
    out = (p.stdout + p.stderr).strip()
    ok = p.returncode == 0
    return {"ok": ok, "steps": [{"cmd": " ".join(cmd), "ok": ok, "output": out[-2000:]}]}


class Handler(BaseHTTPRequestHandler):
    repo_dir = ".yb_light"
    database_url = None

    def _send(self, code, body, ctype):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/" or self.path.startswith("/index"):
            self._send(200, INDEX_HTML.encode("utf-8"), "text/html; charset=utf-8")
        elif self.path.startswith("/api/data"):
            try:
                data = collect(self.repo_dir, self.database_url)
                body = json.dumps(data).encode("utf-8")
                self._send(200, body, "application/json")
            except Exception as e:  # noqa: BLE001
                body = json.dumps({"error": str(e)}).encode("utf-8")
                self._send(500, body, "application/json")
        else:
            self._send(404, b"not found", "text/plain")

    def do_POST(self):
        if self.path.rstrip("/") == "/api/branch":
            try:
                length = int(self.headers.get("Content-Length", 0))
                payload = json.loads(self.rfile.read(length) or b"{}")
            except (ValueError, json.JSONDecodeError) as e:
                self._send(400, json.dumps({"ok": False, "error": f"bad request: {e}"}).encode("utf-8"),
                           "application/json")
                return
            result = create_branch_with_endpoint(
                self.repo_dir, payload.get("tenant_id"), payload.get("ancestor_branch"),
                payload.get("ancestor_timeline_id"))
            code = 200 if result.get("ok") else 500
            self._send(code, json.dumps(result).encode("utf-8"), "application/json")
        elif self.path.rstrip("/") == "/api/tenant":
            result = create_tenant_with_endpoint(self.repo_dir)
            code = 200 if result.get("ok") else 500
            self._send(code, json.dumps(result).encode("utf-8"), "application/json")
        elif self.path.rstrip("/") == "/api/drop":
            try:
                length = int(self.headers.get("Content-Length", 0))
                payload = json.loads(self.rfile.read(length) or b"{}")
            except (ValueError, json.JSONDecodeError) as e:
                self._send(400, json.dumps({"ok": False, "error": f"bad request: {e}"}).encode("utf-8"),
                           "application/json")
                return
            result = drop_branch(self.repo_dir, payload.get("tenant_id"),
                                 payload.get("timeline_id"))
            code = 200 if result.get("ok") else 500
            self._send(code, json.dumps(result).encode("utf-8"), "application/json")
        else:
            self._send(404, b"not found", "text/plain")

    def log_message(self, fmt, *args):  # quieter logs
        pass


def main():
    ap = argparse.ArgumentParser(description="Standalone yb-light cluster UI")
    ap.add_argument("--repo-dir", default=os.environ.get("YB_LIGHT_REPO_DIR", ".yb_light"),
                    help="path to the .yb_light repo dir, for service URLs "
                         "(optional — topology is read from the database)")
    ap.add_argument("--database-url",
                    default=os.environ.get("YB_STORAGE_DATABASE_URL"),
                    help="storage_controller database (default: derived from the "
                         "repo config's [storage_controller.yb] block, else "
                         f"{DEFAULT_DATABASE_URL})")
    ap.add_argument("--host", default="127.0.0.1")
    # 9099 by default: 9000 is YugabyteDB's tserver web UI, 7000 the master UI.
    ap.add_argument("--port", type=int, default=9099)
    ap.add_argument("--once", action="store_true",
                    help="print aggregated JSON once and exit")
    args = ap.parse_args()

    # The repo dir is optional now (topology comes from the database); only
    # warn if a non-default one was asked for but doesn't exist.
    repo_dir = args.repo_dir if os.path.isdir(args.repo_dir) else None
    if repo_dir is None and args.repo_dir != ".yb_light":
        print(f"repo dir {args.repo_dir!r} not found; using defaults for "
              f"service URLs", file=sys.stderr)

    if args.once:
        json.dump(collect(repo_dir, args.database_url), sys.stdout, indent=2)
        print()
        return

    Handler.repo_dir = repo_dir
    Handler.database_url = args.database_url
    try:
        httpd = ThreadingHTTPServer((args.host, args.port), Handler)
    except OSError as e:
        print(f"could not bind {args.host}:{args.port} ({e}); "
              f"pick another with --port", file=sys.stderr)
        sys.exit(1)
    httpd.daemon_threads = True
    print(f"yb-light cluster UI → http://{args.host}:{args.port}  (repo {os.path.abspath(args.repo_dir)})")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
