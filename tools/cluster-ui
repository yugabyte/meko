#!/usr/bin/env python3
#
# Standalone diagnostic UI for a local `yb_amp_local` yb-amp cluster.
#
# Serves a single web page that shows, at a glance:
#   - service health (controller, pageservers, safekeepers,
#     endpoint storage)
#   - pageserver nodes the controller knows about
#   - branches + their lineage (with the load-bearing LSNs:
#     last_record_lsn, disk_consistent_lsn, remote_consistent_lsn, ...)
#   - safekeepers + their branches (commit/flush LSNs)
#   - compute endpoints (from the registry.endpoints table) and
#     whether their compute_ctl is responding
#
# The storage model is branch-centric: the former `(tenant_id, timeline_id)`
# pair has collapsed into a single `branch_id`, and branches form a lineage
# tree via `ancestor_branch_id`. A root branch (no ancestor) is what a
# "tenant" used to be; its descendants are the branches taken off it.
#
# Topology (pageservers, safekeepers, endpoints, branch names) is read
# from the registry schema in yb_storage via psql, not from the
# local repo layout; only the service URLs come from .yb_amp/config.
#
# It runs its own tiny aggregating web server, so the browser only ever
# talks to this one origin — no CORS headers are needed on the storage
# services themselves. The server reaches out to each service's HTTP API
# and merges the results into /api/data (JSON), which the page polls.
#
# Usage:
#   tools/cluster-ui                 # serve on 127.0.0.1:9099, repo .yb_amp
#   tools/cluster-ui --port 9001
#   tools/cluster-ui --repo-dir /path/to/.yb_amp
#   tools/cluster-ui --once          # print the aggregated JSON and exit
#
# Stdlib only; works on Python 3.8+. No build step, no dependencies.

import argparse
import json
import os
import random
import re
import socket
import subprocess
import sys
import urllib.request
import urllib.error
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse

HTTP_TIMEOUT = 2.0  # seconds; the cluster is local, keep the UI snappy

# Where the controller's relational state lives: the
# `registry` schema of the `yb_storage` database (see
# architecture/high-level.md). Topology — pageservers, safekeepers,
# compute endpoints, branch names — is read straight from here rather
# than from the on-disk repo layout, so the tool keeps working as the
# local folder layout evolves and even when run away from the repo.
DEFAULT_DATABASE_URL = "postgresql://yugabyte@127.0.0.1:5433/yb_storage"
REGISTRY_SCHEMA = "registry"
_DB_FIELD_SEP = "\x1f"  # ASCII unit separator — won't appear in our values


def tcp_alive(host, port, timeout=0.5):
    """True if a TCP connection to host:port succeeds."""
    if not port:
        return False
    try:
        with socket.create_connection((host, int(port)), timeout=timeout):
            return True
    except OSError:
        return False


def http_get_json(url):
    """GET a URL and parse JSON. Returns (data, error_string)."""
    try:
        req = urllib.request.Request(url, headers={"Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as resp:
            body = resp.read()
        if not body:
            return (None, None)
        return (json.loads(body.decode("utf-8")), None)
    except urllib.error.HTTPError as e:
        return (None, f"HTTP {e.code}")
    except urllib.error.URLError as e:
        return (None, f"{e.reason}")
    except Exception as e:  # noqa: BLE001 - surface anything in the UI
        return (None, str(e))


def query_db(database_url, sql):
    """Run a read-only query against `database_url` via psql.

    Returns (rows, error_string) where rows is a list of field lists. Shells
    out to psql (no third-party driver needed); PGPASSWORD is sourced from
    $YB_STORAGE_PASSWORD when set.
    """
    env = dict(os.environ)
    pw = os.environ.get("YB_STORAGE_PASSWORD")
    if pw is not None:
        env["PGPASSWORD"] = pw
    try:
        proc = subprocess.run(
            ["psql", database_url, "-tAq", "-F", _DB_FIELD_SEP, "-c", sql],
            capture_output=True, text=True, env=env, timeout=5,
        )
    except FileNotFoundError:
        return (None, "psql not found on PATH")
    except subprocess.TimeoutExpired:
        return (None, "psql query timed out")
    except Exception as e:  # noqa: BLE001
        return (None, str(e))
    if proc.returncode != 0:
        # psql prints a harmless libpq version warning to stderr even on
        # success; only surface stderr when the command actually failed.
        return (None, (proc.stderr.strip() or f"psql exit {proc.returncode}"))
    rows = [line.split(_DB_FIELD_SEP) for line in proc.stdout.splitlines() if line]
    return (rows, None)


# --------------------------------------------------------------------------
# Discovery: service URLs from the repo config; topology from yb_storage.
# --------------------------------------------------------------------------

def _norm_id(v):
    """Strip hyphens so branch ids match API + config formats."""
    return (v or "").replace("-", "").lower()


def _database_url_from_config(cfg_text):
    """Build a psql connection URL from the `[controller.yb]` block.

    The controller's connection lives in the repo config as the
    shared YB block (`host_ports = "host:port[,host:port,...]"`, `user`,
    `dbname`) — the same block the pageserver/safekeeper/endpoint_storage
    consume. We read the first host:port (enough for read-only queries) and
    assemble `postgresql://user@host:port/dbname`. Returns None when no
    `[controller.yb]` block is present.
    """
    m = re.search(r'\[controller\.yb\](.*?)(?:\n\[|\Z)', cfg_text, re.DOTALL)
    if not m:
        return None
    block = m.group(1)
    hp = re.search(r'host_ports\s*=\s*"([^"]+)"', block)
    if not hp:
        return None
    first = hp.group(1).split(",")[0].strip()
    host_port = first if ":" in first else f"{first}:5433"
    um = re.search(r'\buser\s*=\s*"([^"]+)"', block)
    dm = re.search(r'\bdbname\s*=\s*"([^"]+)"', block)
    user = um.group(1) if um else "yugabyte"
    dbname = dm.group(1) if dm else "yb_storage"
    return f"postgresql://{user}@{host_port}/{dbname}"


def discover(repo_dir, database_url=None):
    """Build a topology dict.

    Service *endpoints* (controller HTTP, endpoint-storage HTTP, the
    database URL) come from the repo `config` when it's available, else from
    the dev-cluster defaults. The cluster *topology* — pageservers,
    safekeepers, compute endpoints, branch names — is read from the
    `registry` schema in `yb_storage`, not from the on-disk repo
    layout, so it survives layout changes and works away from the repo.
    """
    cfg_text = ""
    if repo_dir:
        try:
            with open(os.path.join(repo_dir, "config"), "r") as f:
                cfg_text = f.read()
        except OSError:
            pass

    # Controller URL is the host:port of control_plane_api.
    ctrl_url = "http://127.0.0.1:1234"
    m = re.search(r'control_plane_api\s*=\s*"([^"]+)"', cfg_text)
    if m:
        u = urlparse(m.group(1))
        if u.scheme and u.netloc:
            ctrl_url = f"{u.scheme}://{u.netloc}"

    # Endpoint storage listen_addr.
    es_url = "http://127.0.0.1:9993"
    em = re.search(r'\[endpoint_storage\][^\[]*?listen_addr\s*=\s*"([^"]+)"',
                   cfg_text, re.DOTALL)
    if em:
        es_url = f"http://{em.group(1)}"

    # Database URL: explicit flag wins, else build it from the controller's
    # shared YB connection block (`[controller.yb]`: host_ports /
    # user / dbname), else the dev default.
    if not database_url:
        database_url = _database_url_from_config(cfg_text) or DEFAULT_DATABASE_URL

    db_error = None

    def _query(sql):
        nonlocal db_error
        rows, err = query_db(database_url, sql)
        if err and db_error is None:
            db_error = err
        return rows or []

    # Pageservers: the nodes registered with the controller. The
    # controller serves its live node list from /control/v1/node and does
    # not persist it to the registry.nodes table (that table stays
    # empty), so the API is the source of truth. Fall back to the table only
    # if the API is unreachable.
    pageservers = []
    api_nodes, _ = http_get_json(f"{ctrl_url}/control/v1/node")
    for n in api_nodes or []:
        host = n.get("listen_http_addr")
        port = n.get("listen_http_port")
        if n.get("id") is not None and host and port:
            pageservers.append({"id": int(n["id"]), "http": f"http://{host}:{port}"})
    if not pageservers:
        for r in _query(f"SELECT node_id, listen_http_addr, listen_http_port "
                        f"FROM {REGISTRY_SCHEMA}.nodes ORDER BY node_id"):
            if len(r) >= 3:
                pageservers.append({"id": int(r[0]), "http": f"http://{r[1]}:{r[2]}"})

    # Safekeepers.
    safekeepers = []
    for r in _query(f"SELECT id, host, http_port FROM {REGISTRY_SCHEMA}.safekeepers "
                    f"ORDER BY id"):
        if len(r) >= 3:
            safekeepers.append({"id": int(r[0]), "http": f"http://{r[1]}:{r[2]}"})

    # Compute endpoints: the opaque EndpointConf rides along as the spec JSONB.
    # Each spec carries its own `branch_id`, `endpoint_id`, `pg_port`, `mode`,
    # and `external_http_port`.
    endpoints = []
    for r in _query(f"SELECT spec FROM {REGISTRY_SCHEMA}.endpoints"):
        try:
            endpoints.append(json.loads(r[0]))
        except (json.JSONDecodeError, IndexError):
            continue

    # Per-endpoint endpoint_storage address. Each endpoint runs its own
    # endpoint_storage process on its own port, recorded in that endpoint's
    # local `endpoint_storage.json` `listen` field. The cluster `config` only
    # carries a single `[endpoint_storage]` entry, so it can't distinguish
    # them — key by endpoint_id here and fall back to the cluster es_url when
    # the file is absent (e.g. running away from the repo).
    endpoint_storage_by_id: dict = {}
    if repo_dir:
        for ep in endpoints:
            eid = ep.get("endpoint_id")
            if not eid:
                continue
            esj = os.path.join(repo_dir, "endpoints", str(eid),
                               "endpoint_storage", "endpoint_storage.json")
            try:
                with open(esj, "r") as f:
                    listen = json.load(f).get("listen")
                if listen:
                    endpoint_storage_by_id[eid] = f"http://{listen}"
            except (OSError, json.JSONDecodeError):
                continue

    # Branch names from materialized branches (registry.timelines is
    # keyed by branch_id now and carries the human alias in branch_name).
    branch_names = {}
    for r in _query(f"SELECT branch_id, branch_name "
                    f"FROM {REGISTRY_SCHEMA}.timelines "
                    f"WHERE branch_name IS NOT NULL AND deleted_at IS NULL"):
        if len(r) >= 2 and r[1]:
            branch_names[_norm_id(r[0])] = r[1]

    # Pending branch inits: branches created but not yet materialized (endpoint
    # create hasn't run yet, so PS+SK aren't started). These carry
    # ancestor_branch_id and branch_name; we surface them as stub branch
    # entries so the UI shows them immediately after `branch create`.
    db_branches: dict = {}  # branch_id_norm -> {branch_name, ancestor_branch_id}
    for r in _query(f"SELECT branch_id, branch_name, ancestor_branch_id "
                    f"FROM {REGISTRY_SCHEMA}.pending_timeline_inits"):
        if len(r) < 1 or not r[0]:
            continue
        bnorm = _norm_id(r[0])
        if len(r) >= 2 and r[1]:
            branch_names[bnorm] = r[1]
        db_branches[bnorm] = {
            "branch_name": r[1] if len(r) >= 2 else None,
            "ancestor_branch_id": _norm_id(r[2]) if len(r) >= 3 and r[2] else None,
        }

    # Parse [[safekeepers]] http_port from the config file. The DB
    # safekeepers table loses branch SK entries when the cluster is reset,
    # but the config file retains them, making it the reliable source.
    sk_http_by_id: dict = {}
    for m in re.finditer(
        r'\[\[safekeepers\]\][^\[]*?\bid\s*=\s*(\d+)[^\[]*?\bhttp_port\s*=\s*(\d+)',
        cfg_text, re.DOTALL,
    ):
        sk_http_by_id[int(m.group(1))] = f"http://127.0.0.1:{m.group(2)}"

    # SK assignment per branch: sk_set column holds the safekeeper IDs,
    # resolved against the config-parsed port map above.
    branch_sk_urls = {}
    for r in _query(
            f"SELECT branch_id, unnest(sk_set) "
            f"FROM {REGISTRY_SCHEMA}.timelines "
            f"WHERE deleted_at IS NULL"):
        if len(r) >= 2 and r[1]:
            key = _norm_id(r[0])
            if key not in branch_sk_urls:
                try:
                    url = sk_http_by_id.get(int(r[1]))
                    if url:
                        branch_sk_urls[key] = url
                except (ValueError, TypeError):
                    pass

    return {
        "repo_dir": os.path.abspath(repo_dir) if repo_dir else None,
        "database_url": database_url,
        "db_error": db_error,
        "controller": ctrl_url,
        "pageservers": pageservers,
        "safekeepers": safekeepers,
        "endpoint_storage": es_url,
        "endpoint_storage_by_id": endpoint_storage_by_id,
        "endpoints": endpoints,
        "branch_names": branch_names,
        "db_branches": db_branches,
        "branch_sk_urls": branch_sk_urls,
    }


# --------------------------------------------------------------------------
# Aggregation: hit the live APIs and merge.
# --------------------------------------------------------------------------

def collect(repo_dir, database_url=None):
    topo = discover(repo_dir, database_url)
    services = []

    # Controller.
    ctrl = topo["controller"]
    ctrl_status, ctrl_err = http_get_json(f"{ctrl}/status")
    services.append({"name": "controller", "kind": "controller",
                     "url": ctrl, "up": ctrl_err is None, "detail": ctrl_err})

    nodes, nodes_err = http_get_json(f"{ctrl}/control/v1/node")
    ctrl_sks, _ = http_get_json(f"{ctrl}/control/v1/safekeeper")
    sc_branches, _ = http_get_json(f"{ctrl}/control/v1/branch")

    # Pageservers: check status. The pageserver has no branch listing
    # endpoint; branch discovery comes from the controller above.
    ps_alive = {}
    for ps in topo["pageservers"]:
        st, err = http_get_json(f"{ps['http']}/v1/status")
        services.append({"name": f"pageserver-{ps['id']}", "kind": "pageserver",
                         "url": ps["http"], "up": err is None, "detail": err,
                         "info": st})
        ps_alive[ps["id"]] = err is None

    # Branches: discover them from the controller, then query every
    # live pageserver for each branch's timeline detail (the LSNs and the
    # ancestor_branch_id that wires up the lineage tree). A branch is attached
    # to one node, but querying all live nodes keeps discovery robust if the
    # attached node moves.
    ps_http = {ps["id"]: ps["http"] for ps in topo["pageservers"]}
    branches = []
    seen_branches = set()
    for sc_branch in (sc_branches or []):
        bid = sc_branch.get("branch_id")
        if not bid:
            continue
        bnorm = _norm_id(bid)
        seen_branches.add(bnorm)
        # First shard is the display anchor for attachment + scheduling state.
        shards = sc_branch.get("shards", [])
        node_id = shards[0].get("node_attached") if shards else None
        state = shards[0].get("scheduling_policy", "?") if shards else "?"
        # Pull the timeline detail (LSNs, ancestor) from a live pageserver.
        detail = None
        ps_url = None
        for ps_id, http in ps_http.items():
            if not ps_alive.get(ps_id):
                continue
            tl, _ = http_get_json(f"{http}/v1/branch/{bid}/timeline")
            for t in (tl or []):
                if _norm_id(t.get("branch_id")) == bnorm:
                    detail = t
                    ps_url = http
                    break
            if detail:
                break
        entry = {
            "branch_id": bid,
            "ancestor_branch_id": (detail or {}).get("ancestor_branch_id"),
            "branch_name": topo["branch_names"].get(bnorm),
            "state": state,
            "node_attached": node_id,
            "_ps_http": ps_url,
            "last_record_lsn": (detail or {}).get("last_record_lsn"),
            "disk_consistent_lsn": (detail or {}).get("disk_consistent_lsn"),
            "remote_consistent_lsn": (detail or {}).get("remote_consistent_lsn"),
        }
        branches.append(entry)

    # Supplement with branches the controller knows about only as pending
    # inits (created but not yet materialized → PS process not serving them).
    for bnorm, info in topo.get("db_branches", {}).items():
        if bnorm in seen_branches:
            continue
        branches.append({
            "branch_id": bnorm,
            "ancestor_branch_id": info.get("ancestor_branch_id"),
            "branch_name": info.get("branch_name") or topo["branch_names"].get(bnorm),
            "state": "pending",
            "node_attached": None,
            "_ps_http": None,
            "pending": True,
        })

    # Safekeepers + their branches.
    safekeepers = []
    for sk in topo["safekeepers"]:
        st, err = http_get_json(f"{sk['http']}/v1/status")
        services.append({"name": f"safekeeper-{sk['id']}", "kind": "safekeeper",
                         "url": sk["http"], "up": err is None, "detail": err,
                         "info": st})
        # The list endpoint returns bare branch ids; the LSNs (flush_lsn,
        # commit_lsn, remote_consistent_lsn, ...) live on the per-branch detail
        # endpoint, so fetch that for each id.
        tl = []
        if err is None:
            listing, _ = http_get_json(f"{sk['http']}/v1/branch")
            for bid in (listing or []):
                detail = None
                if bid:
                    detail, _ = http_get_json(f"{sk['http']}/v1/branch/{bid}")
                tl.append(detail if isinstance(detail, dict)
                          else {"branch_id": bid})
        safekeepers.append({"id": sk["id"], "url": sk["http"], "up": err is None,
                            "branches": tl})

    # Endpoint storage.
    es = topo["endpoint_storage"]
    _, es_err = http_get_json(f"{es}/status")
    services.append({"name": "endpoint-storage", "kind": "endpoint_storage",
                     "url": es, "up": es_err is None, "detail": es_err})

    # Compute endpoints. compute_ctl's external HTTP /status requires a JWT,
    # so a plain GET 400s; mirror yb_amp_local's own status() and treat the
    # endpoint as up when its Postgres pg_port accepts a TCP connection.
    # /metrics on the external http port is unauthenticated, so use it as a
    # secondary "compute_ctl is alive" signal.
    endpoints = []
    for ep in topo["endpoints"]:
        pg_port = ep.get("pg_port")
        http_port = ep.get("external_http_port")
        running = tcp_alive("127.0.0.1", pg_port)
        ctl_up = tcp_alive("127.0.0.1", http_port)
        cdetail = "serving" if running else ("compute_ctl up, postgres not accepting"
                                             if ctl_up else "down")
        endpoints.append({**ep, "running": running, "compute_ctl_up": ctl_up,
                          "compute_detail": cdetail})

    return {
        "topology": topo,
        "services": services,
        "nodes": nodes or [],
        "nodes_error": nodes_err,
        "sc_safekeepers": ctrl_sks or [],
        "branches": branches,
        "safekeepers": safekeepers,
        "endpoints": endpoints,
    }


