<script>
const $ = (id) => document.getElementById(id);
const esc = (s) => String(s == null ? "" : s).replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
const mono = (s) => `<span class="mono">${esc(s)}</span>`;

// Pull the first present key from an object.
function pick(o, keys) {
  for (const k of keys) if (o && o[k] !== undefined && o[k] !== null) return o[k];
  return undefined;
}

function normId(v) {
  return String(v == null ? "" : v).replace(/-/g, "").toLowerCase();
}

function branchName(branchNames, tenantId, timelineId) {
  if (!branchNames) return null;
  const key = normId(tenantId) + "/" + normId(timelineId);
  return branchNames[key] || null;
}

function branchCell(branchNames, tenantId, timelineId) {
  const name = branchName(branchNames, tenantId, timelineId);
  return name ? `<span class="pill ok">${esc(name)}</span>` : mono('-');
}

function rawDetails(label, obj) {
  return `<details><summary>${esc(label)}</summary><pre>${esc(JSON.stringify(obj, null, 2))}</pre></details>`;
}

function renderServices(svcs) {
  $("services").innerHTML = svcs.map(s => `
    <div class="card">
      <div class="svc"><span class="dot ${s.up?'up':'down'}"></span>${esc(s.name)}</div>
      <div class="url">${esc(s.url)}</div>
      ${s.up ? '' : `<div class="err">${esc(s.detail||'unreachable')}</div>`}
    </div>`).join("");
}

function table(headers, rows) {
  if (!rows.length) return `<div class="empty">none</div>`;
  return `<table><thead><tr>${headers.map(h=>`<th>${esc(h)}</th>`).join("")}</tr></thead>
    <tbody>${rows.map(r=>`<tr>${r.map(c=>`<td>${c}</td>`).join("")}</tr>`).join("")}</tbody></table>`;
}

function renderNodes(nodes, err) {
  if (err) { $("nodes").innerHTML = `<div class="empty">storage controller unreachable: ${esc(err)}</div>`; return; }
  const rows = nodes.map(n => [
    mono(pick(n,['id','node_id'])),
    esc(pick(n,['listen_http_addr'])||'') + ':' + esc(pick(n,['listen_http_port'])||''),
    mono(esc(pick(n,['listen_pg_addr'])||'') + ':' + esc(pick(n,['listen_pg_port'])||'')),
    `<span class="pill ${/active|available/i.test(pick(n,['availability'])||'')?'ok':'warn'}">${esc(pick(n,['availability'])||'?')}</span>`,
    esc(pick(n,['scheduling'])||'-'),
  ]);
  $("nodes").innerHTML = table(["id","http","libpq","availability","scheduling"], rows);
}

function isZeroLsn(v) {
  return v === "0/0" || v === 0;
}

function lsnCell(v, stuck) {
  if (v === undefined || v === null || v === "") return mono('-');
  const cls = isZeroLsn(v) ? "pill bad" : (stuck ? "pill warn" : "");
  const inner = esc(v);
  return cls ? `<span class="${cls}" style="font-family:var(--mono);font-size:12px">${inner}</span>` : mono(v);
}

function lsnCols(tl) {
  return {
    last_record_lsn: pick(tl,['last_record_lsn']),
    disk_consistent_lsn: pick(tl,['disk_consistent_lsn']),
    remote_consistent_lsn: pick(tl,['remote_consistent_lsn']),
    initdb_lsn: pick(tl,['initdb_lsn']),
    ancestor_lsn: pick(tl,['ancestor_lsn']),
    walreceiver_status: pick(tl,['walreceiver_status']),
  };
}

function renderTenants(tenants, branchNames) {
  if (!tenants.length) { $("tenants").innerHTML = `<div class="empty">no tenants attached</div>`; return; }
  $("tenants").innerHTML = tenants.map(entry => {
    const t = entry.tenant;
    const tid = pick(t,['id','tenant_id']);
    const state = pick(t,['state']);
    const stateStr = (typeof state === 'object') ? pick(state,['slug','Attached','state']) || JSON.stringify(state) : state;
    const rows = entry.timelines.map(tl => {
      const l = lsnCols(tl);
      const walDisconnected = /disconnected/i.test(l.walreceiver_status || "");
      const lastStuck = walDisconnected && !!l.last_record_lsn;
      const wal = l.walreceiver_status
        ? `<span class="pill ${walDisconnected ? 'bad' : 'ok'}">${esc((l.walreceiver_status.split(',')[0] || l.walreceiver_status).trim())}</span>`
        : mono('-');
      const tlid = pick(tl,['timeline_id']);
      return [
        branchCell(branchNames, tid, tlid),
        mono(tlid),
        lsnCell(l.last_record_lsn, lastStuck),
        lsnCell(l.disk_consistent_lsn, false),
        lsnCell(l.remote_consistent_lsn, false),
        mono(l.ancestor_lsn && l.ancestor_lsn!=="0/0" ? l.ancestor_lsn : '-'),
        wal,
        rawDetails("raw", tl),
      ];
    });
    return `<div class="tenant">
      <div class="head">
        <span class="tid">${esc(tid)}</span>
        <span class="pill ${/active/i.test(stateStr||'')?'ok':'warn'}">${esc(stateStr||'?')}</span>
        <span class="pill">ps ${esc(entry.pageserver)}</span>
        <span class="pill">${entry.timelines.length} timeline(s)</span>
      </div>
      <div style="padding:10px 14px">
        ${table(["branch","timeline","last_record","disk_consistent","remote_consistent","ancestor","walreceiver",""], rows)}
      </div>
    </div>`;
  }).join("");
}

function renderSafekeepers(sks, branchNames) {
  $("safekeepers").innerHTML = sks.map(sk => {
    const rows = sk.timelines.map(tl => {
      const tenant = pick(tl,['tenant_id']);
      const tlid = pick(tl,['timeline_id']);
      return [
      branchCell(branchNames, tenant, tlid),
      mono(tenant),
      mono(tlid),
      mono(pick(tl,['flush_lsn'])||'-'),
      mono(pick(tl,['commit_lsn'])||'-'),
      mono(pick(tl,['remote_consistent_lsn'])||'-'),
    ];
    });
    return `<div class="tenant">
      <div class="head">
        <span class="dot ${sk.up?'up':'down'}"></span>
        <span>safekeeper ${esc(sk.id)}</span>
        <span class="repo mono">${esc(sk.url)}</span>
        <span class="pill">${sk.timelines.length} timeline(s)</span>
      </div>
      <div style="padding:10px 14px">
        ${table(["branch","tenant","timeline","flush_lsn","commit_lsn","remote_consistent",], rows)}
      </div>
    </div>`;
  }).join("");
}

function renderEndpoints(eps, branchNames) {
  if (!eps.length) { $("endpoints").innerHTML = `<div class="empty">no endpoints created (cargo yb_light endpoint create &lt;name&gt;)</div>`; return; }
  const rows = eps.map(ep => {
    let cls = 'bad', label = 'stopped';
    if (ep.running) { cls = 'ok'; label = 'running'; }
    else if (ep.compute_ctl_up) { cls = 'warn'; label = 'starting'; }
    return [
    esc(ep.endpoint_id),
    branchCell(branchNames, ep.tenant_id, ep.timeline_id),
    `<span class="pill ${cls}" title="${esc(ep.compute_detail||'')}">${label}</span>`,
    esc(ep.mode||'-'),
    mono(ep.tenant_id),
    mono(ep.timeline_id),
    mono('127.0.0.1:'+ep.pg_port),
    mono(ep.external_http_port),
  ];
  });
  $("endpoints").innerHTML = table(
    ["endpoint","branch","compute","mode","tenant","timeline","libpq","http"], rows);
}

async function load() {
  try {
    const r = await fetch("/api/data", {cache:"no-store"});
    const d = await r.json();
    const branchNames = d.topology.branch_names || {};
    $("banner").style.display = "none";
    $("repo").textContent = d.topology.repo_dir;
    renderServices(d.services);
    renderNodes(d.nodes, d.nodes_error);
    renderTenants(d.tenants, branchNames);
    renderSafekeepers(d.safekeepers, branchNames);
    renderEndpoints(d.endpoints, branchNames);
    $("updated").textContent = "updated " + new Date().toLocaleTimeString();
  } catch (e) {
    $("banner").style.display = "block";
    $("banner").textContent = "Failed to load /api/data: " + e;
  }
}

let timer = null;
function tick() {
  if ($("auto").checked) load();
  timer = setTimeout(tick, 4000);
}
load(); tick();
</script>
</body>
</html>
"""


class Handler(BaseHTTPRequestHandler):
    repo_dir = ".yb_light"
    database_url = None

    def _send(self, code, body, ctype):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/" or self.path.startswith("/index"):
            self._send(200, INDEX_HTML.encode("utf-8"), "text/html; charset=utf-8")
        elif self.path.startswith("/api/data"):
            try:
                data = collect(self.repo_dir, self.database_url)
                body = json.dumps(data).encode("utf-8")
                self._send(200, body, "application/json")
            except Exception as e:  # noqa: BLE001
                body = json.dumps({"error": str(e)}).encode("utf-8")
                self._send(500, body, "application/json")
        else:
            self._send(404, b"not found", "text/plain")

    def log_message(self, fmt, *args):  # quieter logs
        pass


def main():
    ap = argparse.ArgumentParser(description="Standalone yb-light cluster UI")
    ap.add_argument("--repo-dir", default=os.environ.get("YB_LIGHT_REPO_DIR", ".yb_light"),
                    help="path to the .yb_light repo dir, for service URLs "
                         "(optional — topology is read from the database)")
    ap.add_argument("--database-url",
                    default=os.environ.get("YB_STORAGE_DATABASE_URL"),
                    help="storage_controller database (default: the repo config's "
                         f"database_url, else {DEFAULT_DATABASE_URL})")
    ap.add_argument("--host", default="127.0.0.1")
    # 9099 by default: 9000 is YugabyteDB's tserver web UI, 7000 the master UI.
    ap.add_argument("--port", type=int, default=9099)
    ap.add_argument("--once", action="store_true",
                    help="print aggregated JSON once and exit")
    args = ap.parse_args()

    # The repo dir is optional now (topology comes from the database); only
    # warn if a non-default one was asked for but doesn't exist.
    repo_dir = args.repo_dir if os.path.isdir(args.repo_dir) else None
    if repo_dir is None and args.repo_dir != ".yb_light":
        print(f"repo dir {args.repo_dir!r} not found; using defaults for "
              f"service URLs", file=sys.stderr)

    if args.once:
        json.dump(collect(repo_dir, args.database_url), sys.stdout, indent=2)
        print()
        return

    Handler.repo_dir = repo_dir
    Handler.database_url = args.database_url
    try:
        httpd = ThreadingHTTPServer((args.host, args.port), Handler)
    except OSError as e:
        print(f"could not bind {args.host}:{args.port} ({e}); "
              f"pick another with --port", file=sys.stderr)
        sys.exit(1)
    httpd.daemon_threads = True
    print(f"yb-light cluster UI → http://{args.host}:{args.port}  (repo {os.path.abspath(args.repo_dir)})")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
