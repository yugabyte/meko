#!/usr/bin/env python3
#
# Standalone diagnostic UI for a local `yb_light_local` yb-light cluster.
#
# Serves a single web page that shows, at a glance:
#   - service health (storage controller, pageservers, safekeepers,
#     endpoint storage)
#   - pageserver nodes the storage controller knows about
#   - tenants + their timelines (with the load-bearing LSNs:
#     last_record_lsn, disk_consistent_lsn, remote_consistent_lsn, ...)
#   - safekeepers + their timelines (commit/flush LSNs)
#   - compute endpoints (from the storage_controller.endpoints table) and
#     whether their compute_ctl is responding
#
# Topology (pageservers, safekeepers, endpoints, branch names) is read
# from the storage_controller schema in yb_storage via psql, not from the
# local repo layout; only the service URLs come from .yb_light/config.
#
# It runs its own tiny aggregating web server, so the browser only ever
# talks to this one origin — no CORS headers are needed on the storage
# services themselves. The server reaches out to each service's HTTP API
# and merges the results into /api/data (JSON), which the page polls.
#
# Usage:
#   tools/cluster-ui                 # serve on 127.0.0.1:9000, repo .yb_light
#   tools/cluster-ui --port 9001
#   tools/cluster-ui --repo-dir /path/to/.yb_light
#   tools/cluster-ui --once          # print the aggregated JSON and exit
#
# Stdlib only; works on Python 3.8+. No build step, no dependencies.

import argparse
import json
import os
import re
import socket
import subprocess
import sys
import urllib.request
import urllib.error
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse

HTTP_TIMEOUT = 2.0  # seconds; the cluster is local, keep the UI snappy

# Where the storage controller's relational state lives: the
# `storage_controller` schema of the `yb_storage` database (see
# architecture/high-level.md). Topology — pageservers, safekeepers,
# compute endpoints, branch names — is read straight from here rather
# than from the on-disk repo layout, so the tool keeps working as the
# local folder layout evolves and even when run away from the repo.
DEFAULT_DATABASE_URL = "postgresql://yugabyte@127.0.0.1:5433/yb_storage"
SC_SCHEMA = "storage_controller"
_DB_FIELD_SEP = "\x1f"  # ASCII unit separator — won't appear in our values


def tcp_alive(host, port, timeout=0.5):
    """True if a TCP connection to host:port succeeds."""
    if not port:
        return False
    try:
        with socket.create_connection((host, int(port)), timeout=timeout):
            return True
    except OSError:
        return False


def http_get_json(url):
    """GET a URL and parse JSON. Returns (data, error_string)."""
    try:
        req = urllib.request.Request(url, headers={"Accept": "application/json"})
        with urllib.request.urlopen(req, timeout=HTTP_TIMEOUT) as resp:
            body = resp.read()
        if not body:
            return (None, None)
        return (json.loads(body.decode("utf-8")), None)
    except urllib.error.HTTPError as e:
        return (None, f"HTTP {e.code}")
    except urllib.error.URLError as e:
        return (None, f"{e.reason}")
    except Exception as e:  # noqa: BLE001 - surface anything in the UI
        return (None, str(e))


def query_db(database_url, sql):
    """Run a read-only query against `database_url` via psql.

    Returns (rows, error_string) where rows is a list of field lists. Shells
    out to psql (no third-party driver needed); PGPASSWORD is sourced from
    $YB_STORAGE_PASSWORD when set.
    """
    env = dict(os.environ)
    pw = os.environ.get("YB_STORAGE_PASSWORD")
    if pw is not None:
        env["PGPASSWORD"] = pw
    try:
        proc = subprocess.run(
            ["psql", database_url, "-tAq", "-F", _DB_FIELD_SEP, "-c", sql],
            capture_output=True, text=True, env=env, timeout=5,
        )
    except FileNotFoundError:
        return (None, "psql not found on PATH")
    except subprocess.TimeoutExpired:
        return (None, "psql query timed out")
    except Exception as e:  # noqa: BLE001
        return (None, str(e))
    if proc.returncode != 0:
        # psql prints a harmless libpq version warning to stderr even on
        # success; only surface stderr when the command actually failed.
        return (None, (proc.stderr.strip() or f"psql exit {proc.returncode}"))
    rows = [line.split(_DB_FIELD_SEP) for line in proc.stdout.splitlines() if line]
    return (rows, None)


# --------------------------------------------------------------------------
# Discovery: service URLs from the repo config; topology from yb_storage.
# --------------------------------------------------------------------------

def _norm_id(v):
    """Strip hyphens so tenant/timeline ids match API + config formats."""
    return (v or "").replace("-", "").lower()


def discover(repo_dir, database_url=None):
    """Build a topology dict.

    Service *endpoints* (storage-controller HTTP, endpoint-storage HTTP, the
    database URL) come from the repo `config` when it's available, else from
    the dev-cluster defaults. The cluster *topology* — pageservers,
    safekeepers, compute endpoints, branch names — is read from the
    `storage_controller` schema in `yb_storage`, not from the on-disk repo
    layout, so it survives layout changes and works away from the repo.
    """
    cfg_text = ""
    if repo_dir:
        try:
            with open(os.path.join(repo_dir, "config"), "r") as f:
                cfg_text = f.read()
        except OSError:
            pass

    # Storage controller URL is the host:port of control_plane_api.
    sc_url = "http://127.0.0.1:1234"
    m = re.search(r'control_plane_api\s*=\s*"([^"]+)"', cfg_text)
    if m:
        u = urlparse(m.group(1))
        if u.scheme and u.netloc:
            sc_url = f"{u.scheme}://{u.netloc}"

    # Endpoint storage listen_addr.
    es_url = "http://127.0.0.1:9993"
    em = re.search(r'\[endpoint_storage\][^\[]*?listen_addr\s*=\s*"([^"]+)"',
                   cfg_text, re.DOTALL)
    if em:
        es_url = f"http://{em.group(1)}"

    # Database URL: explicit flag wins, else the controller's database_url
    # from the repo config, else the dev default.
    if not database_url:
        dm = re.search(r'database_url\s*=\s*"([^"]+)"', cfg_text)
        database_url = dm.group(1) if dm else DEFAULT_DATABASE_URL

    db_error = None

    def _query(sql):
        nonlocal db_error
        rows, err = query_db(database_url, sql)
        if err and db_error is None:
            db_error = err
        return rows or []

    # Pageservers: the nodes registered with the storage controller.
    pageservers = []
    for r in _query(f"SELECT node_id, listen_http_addr, listen_http_port "
                    f"FROM {SC_SCHEMA}.nodes ORDER BY node_id"):
        if len(r) >= 3:
            pageservers.append({"id": int(r[0]), "http": f"http://{r[1]}:{r[2]}"})

    # Safekeepers.
    safekeepers = []
    for r in _query(f"SELECT id, host, http_port FROM {SC_SCHEMA}.safekeepers "
                    f"ORDER BY id"):
        if len(r) >= 3:
            safekeepers.append({"id": int(r[0]), "http": f"http://{r[1]}:{r[2]}"})

    # Compute endpoints: the opaque EndpointConf rides along as the spec JSONB.
    endpoints = []
    for r in _query(f"SELECT spec FROM {SC_SCHEMA}.endpoints"):
        try:
            endpoints.append(json.loads(r[0]))
        except (json.JSONDecodeError, IndexError):
            continue

    # Branch names: each live timeline carries its human-readable alias.
    branch_names = {}
    for r in _query(f"SELECT tenant_id, timeline_id, branch_name "
                    f"FROM {SC_SCHEMA}.timelines "
                    f"WHERE branch_name IS NOT NULL AND deleted_at IS NULL"):
        if len(r) >= 3 and r[2]:
            branch_names[f"{_norm_id(r[0])}/{_norm_id(r[1])}"] = r[2]

    return {
        "repo_dir": os.path.abspath(repo_dir) if repo_dir else None,
        "database_url": database_url,
        "db_error": db_error,
        "storage_controller": sc_url,
        "pageservers": pageservers,
        "safekeepers": safekeepers,
        "endpoint_storage": es_url,
        "endpoints": endpoints,
        "branch_names": branch_names,
    }


# --------------------------------------------------------------------------
# Aggregation: hit the live APIs and merge.
# --------------------------------------------------------------------------

def collect(repo_dir, database_url=None):
    topo = discover(repo_dir, database_url)
    services = []

    # Storage controller.
    sc = topo["storage_controller"]
    sc_status, sc_err = http_get_json(f"{sc}/status")
    services.append({"name": "storage-controller", "kind": "storage_controller",
                     "url": sc, "up": sc_err is None, "detail": sc_err})

    nodes, nodes_err = http_get_json(f"{sc}/control/v1/node")
    sc_sks, _ = http_get_json(f"{sc}/control/v1/safekeeper")

    # Pageservers + their tenants/timelines.
    tenants = []
    for ps in topo["pageservers"]:
        st, err = http_get_json(f"{ps['http']}/v1/status")
        services.append({"name": f"pageserver-{ps['id']}", "kind": "pageserver",
                         "url": ps["http"], "up": err is None, "detail": err,
                         "info": st})
        if err is not None:
            continue
        tlist, terr = http_get_json(f"{ps['http']}/v1/tenant")
        for t in (tlist or []):
            tid = t.get("id") or t.get("tenant_id")
            timelines = []
            if tid:
                tl, _ = http_get_json(f"{ps['http']}/v1/tenant/{tid}/timeline")
                timelines = tl or []
            tenants.append({"pageserver": ps["id"], "tenant": t,
                            "timelines": timelines})

    # Safekeepers + their timelines.
    safekeepers = []
    for sk in topo["safekeepers"]:
        st, err = http_get_json(f"{sk['http']}/v1/status")
        services.append({"name": f"safekeeper-{sk['id']}", "kind": "safekeeper",
                         "url": sk["http"], "up": err is None, "detail": err,
                         "info": st})
        # The list endpoint only returns {tenant_id, timeline_id}; the LSNs
        # (flush_lsn, commit_lsn, remote_consistent_lsn, ...) live on the
        # per-timeline detail endpoint, so fetch that for each entry.
        tl = []
        if err is None:
            listing, _ = http_get_json(f"{sk['http']}/v1/tenant/timeline")
            for entry in (listing or []):
                tid = entry.get("tenant_id")
                tlid = entry.get("timeline_id")
                detail = None
                if tid and tlid:
                    detail, _ = http_get_json(
                        f"{sk['http']}/v1/tenant/{tid}/timeline/{tlid}")
                tl.append(detail if isinstance(detail, dict) else entry)
        safekeepers.append({"id": sk["id"], "url": sk["http"], "up": err is None,
                            "timelines": tl})

    # Endpoint storage.
    es = topo["endpoint_storage"]
    _, es_err = http_get_json(f"{es}/status")
    services.append({"name": "endpoint-storage", "kind": "endpoint_storage",
                     "url": es, "up": es_err is None, "detail": es_err})

    # Compute endpoints. compute_ctl's external HTTP /status requires a JWT,
    # so a plain GET 400s; mirror yb_light_local's own status() and treat the
    # endpoint as up when its Postgres pg_port accepts a TCP connection.
    # /metrics on the external http port is unauthenticated, so use it as a
    # secondary "compute_ctl is alive" signal.
    endpoints = []
    for ep in topo["endpoints"]:
        pg_port = ep.get("pg_port")
        http_port = ep.get("external_http_port")
        running = tcp_alive("127.0.0.1", pg_port)
        ctl_up = tcp_alive("127.0.0.1", http_port)
        cdetail = "serving" if running else ("compute_ctl up, postgres not accepting"
                                             if ctl_up else "down")
        endpoints.append({**ep, "running": running, "compute_ctl_up": ctl_up,
                          "compute_detail": cdetail})

    return {
        "topology": topo,
        "services": services,
        "nodes": nodes or [],
        "nodes_error": nodes_err,
        "sc_safekeepers": sc_sks or [],
        "tenants": tenants,
        "safekeepers": safekeepers,
        "endpoints": endpoints,
    }


