<script>
const $ = (id) => document.getElementById(id);
const esc = (s) => String(s == null ? "" : s).replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
const mono = (s) => `<span class="mono">${esc(s)}</span>`;

function pick(o, keys) {
  for (const k of keys) if (o && o[k] !== undefined && o[k] !== null) return o[k];
  return undefined;
}

function normId(v) {
  return String(v == null ? "" : v).replace(/-/g, "").toLowerCase();
}

function branchCell(branchNames, tenantId, timelineId) {
  const key = normId(tenantId) + "/" + normId(timelineId);
  const name = branchNames[key] || null;
  return name ? `<span class="pill ok">${esc(name)}</span>` : mono('-');
}

function table(headers, rows) {
  if (!rows.length) return `<div class="empty">none</div>`;
  return `<table><thead><tr>${headers.map(h=>`<th>${esc(h)}</th>`).join("")}</tr></thead>
    <tbody>${rows.map(r=>`<tr>${r.map(c=>`<td>${c}</td>`).join("")}</tr>`).join("")}</tbody></table>`;
}

function renderServices(svcs) {
  const show = svcs.filter(s => s.kind !== 'pageserver' && s.kind !== 'safekeeper' && s.kind !== 'endpoint_storage');
  $("services").innerHTML = show.map(s => `
    <div class="card">
      <div class="svc"><span class="dot ${s.up?'up':'down'}"></span>${esc(s.name)}</div>
      <div class="url">${esc(s.url)}</div>
      ${s.up ? '' : `<div class="err">${esc(s.detail||'unreachable')}</div>`}
    </div>`).join("");
}

function buildTlTree(timelines) {
  const byId = {};
  for (const tl of timelines) byId[normId(tl.timeline_id)] = {tl, children: []};
  const roots = [];
  for (const tl of timelines) {
    const anc = tl.ancestor_timeline_id;
    const parent = anc ? byId[normId(anc)] : null;
    if (parent) parent.children.push(byId[normId(tl.timeline_id)]);
    else roots.push(byId[normId(tl.timeline_id)]);
  }
  return roots;
}

function renderTlNode(node, ctx) {
  const {branchNames, tid, epByTl, skByTl, esUrl} = ctx;
  const tl = node.tl;
  const tlid = tl.timeline_id;
  const key = normId(tid) + '/' + normId(tlid);
  const branch = branchNames[key];
  const skHttp = skByTl[key] || null;
  const eps = epByTl[key] || [];

  const branchPill = branch
    ? `<span class="pill branch">${esc(branch)}</span>`
    : `<span class="pill">${mono(tlid.slice(0,8)+'…')}</span>`;

  const portOf = url => url ? url.split(':').pop() : '-';
  const psCell = mono(tl._ps_http ? portOf(tl._ps_http) : '-');
  const skCell = mono(skHttp ? portOf(skHttp) : '-');
  const esCell = mono(esUrl ? portOf(esUrl) : '-');

  let epSection = '';
  if (eps.length) {
    const rows = eps.map(ep => {
      let cls = 'bad', label = 'stopped';
      if (ep.running) { cls = 'ok'; label = 'running'; }
      else if (ep.compute_ctl_up) { cls = 'warn'; label = 'starting'; }
      return `<tr>
        <td>${esc(ep.endpoint_id)}</td>
        <td><span class="pill ${cls}">${label}</span></td>
        <td>${esc(ep.mode || '-')}</td>
        <td class="mono">127.0.0.1:${esc(ep.pg_port)}</td>
        <td class="mono">${esc(ep.external_http_port || '-')}</td>
        <td>${psCell}</td>
        <td>${skCell}</td>
        <td>${esCell}</td>
      </tr>`;
    }).join('');
    epSection = `<table class="ep-table">
      <thead><tr>
        <th>endpoint</th><th>state</th><th>mode</th><th>libpq</th><th>pg http</th><th>ps http</th><th>sk http</th><th>es http</th>
      </tr></thead>
      <tbody>${rows}</tbody>
    </table>`;
  }

  const childrenHtml = node.children.length
    ? `<div class="tl-children">${node.children.map(c => renderTlNode(c, ctx)).join('')}</div>`
    : '';

  return `<div class="tl-tree-node">
    <div class="tl-block">
      <div class="tl-head">
        ${branchPill} <span class="tl-label">Timeline:</span> ${mono(tlid)}
      </div>
      ${epSection}
    </div>
    ${childrenHtml}
  </div>`;
}

function renderUnified(d) {
  const branchNames = d.topology.branch_names || {};

  // DB-derived mapping covers all timelines including branches; the SK
  // runtime listing only returns timelines it has loaded in memory.
  const skByTl = d.topology.timeline_sk_urls || {};

  const epByTl = {};
  for (const ep of d.endpoints || []) {
    const key = normId(ep.tenant_id) + '/' + normId(ep.timeline_id);
    if (!epByTl[key]) epByTl[key] = [];
    epByTl[key].push(ep);
  }

  if (!d.tenants || !d.tenants.length) {
    $("unified").innerHTML = `<div class="empty">no tenants</div>`;
    return;
  }

  $("unified").innerHTML = (d.tenants || []).map(entry => {
    const tid = pick(entry.tenant, ['id','tenant_id']);
    const state = entry.tenant.state || '?';
    const ctx = {branchNames, tid, epByTl, skByTl, esUrl: d.topology.endpoint_storage};
    const roots = buildTlTree(entry.timelines || []);
    const tlsHtml = roots.map(r => renderTlNode(r, ctx)).join('');

    return `<div class="tenant">
      <div class="head">
        <span class="tl-label">Tenant:</span> <span class="tid">${esc(tid)}</span>
        <span class="pill ${/active/i.test(state)?'ok':'warn'}">${esc(state)}</span>
        <span class="pill">${entry.timelines.length} branches(s)</span>
      </div>
      ${tlsHtml}
    </div>`;
  }).join('');
}

async function load() {
  try {
    const r = await fetch("/api/data", {cache:"no-store"});
    const d = await r.json();
    $("banner").style.display = "none";
    $("repo").textContent = d.topology.repo_dir;
    renderServices(d.services);
    renderUnified(d);
    $("updated").textContent = "updated " + new Date().toLocaleTimeString();
  } catch (e) {
    $("banner").style.display = "block";
    $("banner").textContent = "Failed to load /api/data: " + e;
  }
}

let timer = null;
function tick() {
  if ($("auto").checked) load();
  timer = setTimeout(tick, 4000);
}
load(); tick();
</script>
</body>
</html>
"""


class Handler(BaseHTTPRequestHandler):
    repo_dir = ".yb_light"
    database_url = None

    def _send(self, code, body, ctype):
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        if self.path == "/" or self.path.startswith("/index"):
            self._send(200, INDEX_HTML.encode("utf-8"), "text/html; charset=utf-8")
        elif self.path.startswith("/api/data"):
            try:
                data = collect(self.repo_dir, self.database_url)
                body = json.dumps(data).encode("utf-8")
                self._send(200, body, "application/json")
            except Exception as e:  # noqa: BLE001
                body = json.dumps({"error": str(e)}).encode("utf-8")
                self._send(500, body, "application/json")
        else:
            self._send(404, b"not found", "text/plain")

    def log_message(self, fmt, *args):  # quieter logs
        pass


def main():
    ap = argparse.ArgumentParser(description="Standalone yb-light cluster UI")
    ap.add_argument("--repo-dir", default=os.environ.get("YB_LIGHT_REPO_DIR", ".yb_light"),
                    help="path to the .yb_light repo dir, for service URLs "
                         "(optional — topology is read from the database)")
    ap.add_argument("--database-url",
                    default=os.environ.get("YB_STORAGE_DATABASE_URL"),
                    help="storage_controller database (default: the repo config's "
                         f"database_url, else {DEFAULT_DATABASE_URL})")
    ap.add_argument("--host", default="127.0.0.1")
    # 9099 by default: 9000 is YugabyteDB's tserver web UI, 7000 the master UI.
    ap.add_argument("--port", type=int, default=9099)
    ap.add_argument("--once", action="store_true",
                    help="print aggregated JSON once and exit")
    args = ap.parse_args()

    # The repo dir is optional now (topology comes from the database); only
    # warn if a non-default one was asked for but doesn't exist.
    repo_dir = args.repo_dir if os.path.isdir(args.repo_dir) else None
    if repo_dir is None and args.repo_dir != ".yb_light":
        print(f"repo dir {args.repo_dir!r} not found; using defaults for "
              f"service URLs", file=sys.stderr)

    if args.once:
        json.dump(collect(repo_dir, args.database_url), sys.stdout, indent=2)
        print()
        return

    Handler.repo_dir = repo_dir
    Handler.database_url = args.database_url
    try:
        httpd = ThreadingHTTPServer((args.host, args.port), Handler)
    except OSError as e:
        print(f"could not bind {args.host}:{args.port} ({e}); "
              f"pick another with --port", file=sys.stderr)
        sys.exit(1)
    httpd.daemon_threads = True
    print(f"yb-light cluster UI → http://{args.host}:{args.port}  (repo {os.path.abspath(args.repo_dir)})")
    try:
        httpd.serve_forever()
    except KeyboardInterrupt:
        pass


if __name__ == "__main__":
    main()
