#!/usr/bin/env python3
"""Dump or decode `pageserver.pages` rows.

Two modes share one set of filters and connection flags:

LIST (default) — one line per row: lsn, fork, is_image/will_init, and a
  payload-size + hex-prefix sample. Spans a blknum range; newest row per
  page first.

DECODE (--decode) — for a SINGLE block, walk the chain in the order
  walredo applies it (LSN-ascending) and decode each row:
    image rows -> the page line-pointer table summary + max offset
    delta rows -> the WAL record's resource manager, op, and target
                  offset (the offnum a HEAP/neon INSERT/UPDATE writes)
  while tracking the running max line-pointer. A delta whose target
  offnum exceeds running_max+1 is flagged as a GAP — the signature of a
  chain walredo cannot fold (`neon_rm_redo: invalid max offset number` /
  `failed to add new item`) and of a base image whose page-state is too
  small for the deltas stacked on it (a "landmine"; see issue #22).

Hash columns (required, all modes):
  --tenant <hex>   --timeline <hex>
  --spc <int>      --db <int>     --rel <int>     --fork <0..3>

Block / range filters:
  --blknum <int>          single block (REQUIRED for --decode)
  --blknum-from <int>     inclusive (LIST only)
  --blknum-to   <int>     inclusive (LIST only)
  --lsn-from    <X/Y>     inclusive (PG LSN hex, or a plain bigint)
  --lsn-to      <X/Y>     inclusive

LIST-only options:
  --limit <int>     default 50, 0 = no limit
  --no-payload      skip the payload sample column
  --raw             psql expanded table instead of the prettified lines

Connection (optional):
  --host <h> (def 127.0.0.1)   --port <p> (def 5433)
  --user <u> (def yugabyte)    --db-name <n> (def yb_storage)
  --sslmode <m> (def prefer)   --password-env <ENV> (PGPASSWORD wins)

Needs `psql` on PATH; reads the password from $PGPASSWORD (or --password-env).
"""
import argparse
import os
import struct
import subprocess
import sys

# Postgres resource-manager ids we name in output; 134 is Neon's custom RM.
RMGR = {0: "XLOG", 1: "Xact", 2: "Storage", 3: "CLOG", 8: "Standby",
        9: "Heap2", 10: "Heap", 11: "Btree", 134: "neon"}
# Neon RM op (xl_info & 0x70) -> name. Mirrors the redo handler's switch.
NEON_OPS = {0x00: "INSERT", 0x10: "DELETE", 0x20: "UPDATE",
            0x30: "HOT_UPDATE", 0x40: "LOCK", 0x50: "MULTI_INSERT"}
FORK_NAMES = {0: "main", 1: "fsm", 2: "vm", 3: "init"}


def parse_lsn(s):
    """`X/Y` (hex) or a plain integer -> bigint."""
    s = s.strip()
    if "/" in s:
        hi, lo = s.split("/", 1)
        return (int(hi, 16) << 32) | int(lo, 16)
    return int(s, 0)


def fmt_lsn(v):
    return f"{v >> 32:X}/{v & 0xFFFFFFFF:08X}"


def conn_str(a):
    return (f"host={a.host} port={a.port} user={a.user} "
            f"dbname={a.db_name} sslmode={a.sslmode}")


def run_psql(a, sql, extra_args=()):
    env = dict(os.environ)
    env.setdefault("PATH", "/usr/bin:/bin")
    pw = os.environ.get("PGPASSWORD") or os.environ.get(a.password_env, "")
    if pw:
        env["PGPASSWORD"] = pw
    out = subprocess.run(["psql", conn_str(a), *extra_args, "-c", sql],
                         capture_output=True, text=True, env=env)
    if out.returncode != 0:
        sys.exit(f"psql failed: {out.stderr.strip()}")
    return out.stdout


def base_where(a):
    where = (f"tenant_id='{a.tenant}' and timeline_id='{a.timeline}' "
             f"and spcnode={a.spc} and dbnode={a.db} and relnode={a.rel} "
             f"and forknum={a.fork}")
    if a.lsn_from is not None:
        where += f" and lsn >= {a.lsn_from}"
    if a.lsn_to is not None:
        where += f" and lsn <= {a.lsn_to}"
    return where


# ---------------------------------------------------------------- LIST mode

def list_mode(a):
    where = base_where(a)
    if a.blknum is not None:
        where += f" and blknum = {a.blknum}"
    if a.blknum_from is not None:
        where += f" and blknum >= {a.blknum_from}"
    if a.blknum_to is not None:
        where += f" and blknum <= {a.blknum_to}"
    payload_col = ("" if a.no_payload else
                   ", octet_length(payload) as bytes"
                   ", encode(substring(payload,1,16),'hex') as payload_head")
    limit = "" if a.limit == 0 else f"limit {a.limit}"
    # Order by the numeric lsn DESC (newest first). Rendering to hex happens
    # in Python so the sort is numeric, not lexicographic.
    sql = (f"select blknum, lsn, forknum, is_image, will_init{payload_col} "
           f"from pageserver.pages where {where} "
           f"order by blknum asc, lsn desc, is_image asc {limit}")
    if a.raw:
        sys.stdout.write(run_psql(a, sql, ["-x"]))
        return
    for line in run_psql(a, sql, ["-tA"]).strip().splitlines():
        if not line.strip():
            continue
        f = line.split("|")
        blk, lsn, fork, is_img, will_init = f[0], int(f[1]), int(f[2]), f[3], f[4]
        tail = ""
        if not a.no_payload:
            tail = f"  {f[5]}B  {f[6]}"
        print(f"blk={blk:>10}  {fmt_lsn(lsn):>14}  {FORK_NAMES.get(fork, fork):<4}  "
              f"img={is_img} init={will_init}{tail}")


# -------------------------------------------------------------- DECODE mode

def lp_state(page):
    """(max_off, {flag-name: count}) from a raw 8KB heap page image."""
    (_lo, _hi, _ck, _fl, pd_lower, _up, _sp, _v, _pr) = \
        struct.unpack_from("<IIHHHHHHI", page, 0)
    nlp = (pd_lower - 24) // 4
    counts = {}
    for i in range(nlp):
        (dw,) = struct.unpack_from("<I", page, 24 + i * 4)
        flag = ("UNUSED", "NORMAL", "REDIRECT", "DEAD")[(dw >> 15) & 0x3]
        counts[flag] = counts.get(flag, 0) + 1
    return nlp, counts


def decode_record(rec):
    """Raw XLogRecord bytes -> (rmid, info, maindata)."""
    (xl_tot_len,) = struct.unpack_from("<I", rec, 0)
    xl_info, xl_rmid = struct.unpack_from("<BB", rec, 16)
    pos, maindata = 24, b""
    while pos < xl_tot_len:
        (blkid,) = struct.unpack_from("<B", rec, pos)
        if blkid == 255:                       # XLR_BLOCK_ID_DATA_SHORT
            (ln,) = struct.unpack_from("<B", rec, pos + 1)
            maindata = rec[xl_tot_len - ln:xl_tot_len]
            break
        elif blkid == 254:                     # XLR_BLOCK_ID_DATA_LONG
            (ln,) = struct.unpack_from("<I", rec, pos + 1)
            maindata = rec[xl_tot_len - ln:xl_tot_len]
            break
        elif blkid in (253, 252):              # ORIGIN / TOPLEVEL_XID
            pos += 1 + (2 if blkid == 253 else 4)
        elif blkid <= 32:                      # block reference
            fork_flags, _data_len = struct.unpack_from("<BH", rec, pos + 1)
            pos += 4
            if fork_flags & 0x10:              # BKPBLOCK_HAS_IMAGE
                _il, _ho, bimg_info = struct.unpack_from("<HHB", rec, pos)
                pos += 5
                if bimg_info & 0x04:           # COMPRESSED -> hole_length follows
                    pos += 2
            if not fork_flags & 0x80:          # not BKPBLOCK_SAME_REL
                pos += 12
            pos += 4                           # blkno
        else:
            raise ValueError(f"unknown blkid {blkid} at offset {pos}")
    return xl_rmid, xl_info, maindata


def neon_offnum(info, md):
    """(op-name, target offnum or None) for a Neon-RM record."""
    op = NEON_OPS.get(info & 0x70, f"op{info & 0x70:#x}")
    init = "+INIT" if info & 0x80 else ""
    try:
        if op == "INSERT":
            (off,) = struct.unpack_from("<H", md, 0)
            return op + init, off
        if op in ("UPDATE", "HOT_UPDATE"):
            (_ox, _oo, _ib, _fl, _cid, _nx, new_off) = \
                struct.unpack_from("<IHBBIIH", md, 0)
            return op + init, new_off
        if op == "DELETE":
            (_xmax, off) = struct.unpack_from("<IH", md, 0)
            return op + init, off
    except struct.error:
        pass
    return op + init, None


def decode_mode(a):
    if a.blknum is None:
        sys.exit("--decode needs a single --blknum (a chain is per-block)")
    where = base_where(a) + f" and blknum = {a.blknum}"
    # LSN-ascending, image-first on ties (an image supersedes a same-LSN delta).
    sql = (f"select to_hex(lsn), is_image::int, will_init::int, encode(payload,'hex') "
           f"from pageserver.pages where {where} order by lsn, is_image desc")
    rows = []
    for line in run_psql(a, sql, ["-tA"]).strip().splitlines():
        if not line.strip():
            continue
        lh, im, wi, pl = line.split("|")
        rows.append((int(lh, 16), int(im), int(wi), bytes.fromhex(pl)))

    lo = f" from {fmt_lsn(a.lsn_from)}" if a.lsn_from is not None else ""
    hi = f" to {fmt_lsn(a.lsn_to)}" if a.lsn_to is not None else ""
    print(f"{len(rows)} rows for rel={a.rel} blk={a.blknum}{lo}{hi}\n")

    running_max = 0  # highest line-pointer the chain has reached so far
    gaps = 0
    for lsn, is_img, will_init, payload in rows:
        if is_img:
            max_off, counts = lp_state(payload)
            running_max = max(running_max, max_off)
            print(f"IMAGE  {fmt_lsn(lsn)}  will_init={will_init}  "
                  f"max_off={max_off}  {counts}")
            continue
        # Delta: 13-byte BE-bincode header (variant u32 + will_init u8 +
        # len u64) then the raw XLogRecord.
        rec = payload[13:]
        declared = int.from_bytes(payload[5:13], "big")
        if len(rec) != declared:
            print(f"DELTA  {fmt_lsn(lsn)}  !! framing: len={len(rec)} declared={declared}")
            continue
        rmid, info, md = decode_record(rec)
        rmname = RMGR.get(rmid, f"rm{rmid}")
        if rmid == 134:
            op, off = neon_offnum(info, md)
        else:
            op, off = f"info={info:#x}", None
        flag = ""
        if off is not None and op.startswith(("INSERT", "UPDATE", "HOT_UPDATE")):
            if off > running_max + 1:
                flag = (f"   <-- GAP: offnum {off} > running_max+1 "
                        f"({running_max + 1}); chain/base inconsistent")
                gaps += 1
            running_max = max(running_max, off)
        offstr = f" off={off}" if off is not None else ""
        print(f"DELTA  {fmt_lsn(lsn)}  {rmname}/{op}{offstr}{flag}")

    print()
    if gaps:
        print(f"** {gaps} GAP(s) — this chain does not fold cleanly "
              f"(walredo would PANIC). See issue #22.")
    else:
        print("no offnum gaps — chain line-pointers are contiguous")


def main():
    p = argparse.ArgumentParser(add_help=False)
    p.add_argument("--decode", action="store_true")
    p.add_argument("--tenant", required=True)
    p.add_argument("--timeline", required=True)
    p.add_argument("--spc", type=int, required=True)
    p.add_argument("--db", type=int, required=True)
    p.add_argument("--rel", type=int, required=True)
    p.add_argument("--fork", type=int, required=True)
    p.add_argument("--blknum", type=int, default=None)
    p.add_argument("--blknum-from", type=int, default=None, dest="blknum_from")
    p.add_argument("--blknum-to", type=int, default=None, dest="blknum_to")
    p.add_argument("--lsn-from", type=parse_lsn, default=None, dest="lsn_from")
    p.add_argument("--lsn-to", type=parse_lsn, default=None, dest="lsn_to")
    p.add_argument("--limit", type=int, default=50)
    p.add_argument("--no-payload", action="store_true", dest="no_payload")
    p.add_argument("--raw", action="store_true")
    p.add_argument("--host", default="127.0.0.1")
    p.add_argument("--port", default="5433")
    p.add_argument("--user", default="yugabyte")
    p.add_argument("--db-name", default="yb_storage", dest="db_name")
    p.add_argument("--sslmode", default="prefer")
    p.add_argument("--password-env", default="PGPASSWORD", dest="password_env")
    p.add_argument("-h", "--help", action="store_true")
    a = p.parse_args()
    if a.help:
        print(__doc__)
        return
    if a.decode:
        decode_mode(a)
    else:
        list_mode(a)


if __name__ == "__main__":
    main()
