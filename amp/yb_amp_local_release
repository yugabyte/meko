#!/usr/bin/env bash
# Convenience wrapper: run the release-profile yb_amp_local binary.
#
# Same as the sibling `yb_amp_local` script but targets
# target/release/. For day-to-day dev iteration prefer the debug
# wrapper; use this when you specifically need the optimized build.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$REPO/target/release/yb_amp_local"

[[ -x "$BIN" ]] || {
  echo "yb_amp_local release binary not found at $BIN" >&2
  echo "build it first: go build -C controller -o target/release/yb_amp_local ./local/cmd/yb_amp_local" >&2
  exit 1
}

# The launcher defaults POSTGRES_DISTRIB_DIR to $cwd/pg_install — the release
# bundle's layout, not a tree a checkout has — so the repo wrappers name the
# tree matching their profile. An ambient value wins, for a caller pointing at a
# tree it built elsewhere.
export POSTGRES_DISTRIB_DIR="${POSTGRES_DISTRIB_DIR:-$REPO/pg_install-release}"

exec "$BIN" "$@"
