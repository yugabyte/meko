{
  "title": "amp — Cache hit/miss (buffers → LFC → pageserver)",
  "uid": "amp-cache",
  "tags": [
    "amp",
    "cache",
    "postgres",
    "pageserver"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "description": "Cache behaviour along amp's read path, in the order a page request travels it: Postgres shared buffers, the compute's local file cache (LFC), the pageserver's relsize/fast/basebackup caches, and the safekeeper WAL cache. A miss at each layer is more expensive than the last.",
  "templating": {
    "list": [
      {
        "name": "endpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(pg_up, endpoint)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Headline — one stat per cache layer",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Shared-buffers hit ratio",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 98
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * sum (rate(pg_stat_database_blks_hit_total{endpoint=~\"$endpoint\"}[$__rate_interval]) or rate(pg_stat_database_blks_read_total{endpoint=~\"$endpoint\"}[$__rate_interval]) * 0) / clamp_min(sum (rate(pg_stat_database_blks_hit_total{endpoint=~\"$endpoint\"}[$__rate_interval]) or rate(pg_stat_database_blks_read_total{endpoint=~\"$endpoint\"}[$__rate_interval]) * 0) + sum (rate(pg_stat_database_blks_read_total{endpoint=~\"$endpoint\"}[$__rate_interval]) or rate(pg_stat_database_blks_hit_total{endpoint=~\"$endpoint\"}[$__rate_interval]) * 0), 1)",
          "legendFormat": "value"
        }
      ],
      "description": "Reads served from shared_buffers. A miss here falls through to the LFC."
    },
    {
      "type": "stat",
      "title": "LFC hit ratio",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 98
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * sum (rate(lfc_hits{endpoint=~\"$endpoint\"}[$__rate_interval]) or rate(lfc_misses{endpoint=~\"$endpoint\"}[$__rate_interval]) * 0) / clamp_min(sum (rate(lfc_hits{endpoint=~\"$endpoint\"}[$__rate_interval]) or rate(lfc_misses{endpoint=~\"$endpoint\"}[$__rate_interval]) * 0) + sum (rate(lfc_misses{endpoint=~\"$endpoint\"}[$__rate_interval]) or rate(lfc_hits{endpoint=~\"$endpoint\"}[$__rate_interval]) * 0), 1)",
          "legendFormat": "value"
        }
      ],
      "description": "Of the reads shared_buffers missed, the share the compute's local file cache served from local disk. A miss here becomes a getpage over the network."
    },
    {
      "type": "stat",
      "title": "getpage req/s → pageserver",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(pageserver_smgr_query_started_count_total{endpoint=~\"$endpoint\",smgr_query_type=\"get_page_at_lsn\"}[$__rate_interval]))",
          "legendFormat": "value"
        }
      ],
      "description": "What actually left the compute: a buffer miss the LFC could not serve."
    },
    {
      "type": "stat",
      "title": "pageserver fast_cache share",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 98
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * sum(rate(pageserver_yb_page_reads_total{endpoint=~\"$endpoint\",path=\"fast_cache\"}[$__rate_interval])) / clamp_min(sum(rate(pageserver_yb_page_reads_total{endpoint=~\"$endpoint\"}[$__rate_interval])), 1)",
          "legendFormat": "value"
        }
      ],
      "description": "Last layer: of the page reads reaching the pageserver, the share it served without going to YugabyteDB."
    },
    {
      "type": "row",
      "title": "1. Postgres shared buffers (pg_stat_database / pg_statio)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Hit ratio % per endpoint — the trend to watch",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "unit": "percent",
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * sum by (endpoint) (rate(pg_stat_database_blks_hit_total{endpoint=~\"$endpoint\"}[$__rate_interval]) or rate(pg_stat_database_blks_read_total{endpoint=~\"$endpoint\"}[$__rate_interval]) * 0) / clamp_min(sum by (endpoint) (rate(pg_stat_database_blks_hit_total{endpoint=~\"$endpoint\"}[$__rate_interval]) or rate(pg_stat_database_blks_read_total{endpoint=~\"$endpoint\"}[$__rate_interval]) * 0) + sum by (endpoint) (rate(pg_stat_database_blks_read_total{endpoint=~\"$endpoint\"}[$__rate_interval]) or rate(pg_stat_database_blks_hit_total{endpoint=~\"$endpoint\"}[$__rate_interval]) * 0), 1)",
          "legendFormat": "{{endpoint}}"
        }
      ],
      "description": "A downward slope is the signal: the same workload is finding less of its working set in shared_buffers."
    },
