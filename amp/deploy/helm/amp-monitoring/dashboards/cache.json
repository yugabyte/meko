          "instant": true,
          "format": "table",
          "expr": "topk(15, sum by (endpoint, datname, relname) (rate({__name__=~\"pg_statio_user_tables_(heap|idx|toast|tidx)_blocks_read_total\",endpoint=~\"$endpoint\"}[$__rate_interval])))"
        }
