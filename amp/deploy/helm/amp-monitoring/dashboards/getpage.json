{
  "title": "amp — getpage SLO & backpressure",
  "uid": "amp-getpage",
  "tags": [
    "amp",
    "pageserver",
    "getpage",
    "latency"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "What a page request costs once it leaves the compute: wait_lsn (blocking until the requested LSN has been ingested), tenant throttling, request batching/pipelining, and the page_service connection surface.",
  "templating": {
    "list": [
      {
        "name": "endpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(pg_up, endpoint)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Headline",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "getpage p99",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pageserver_smgr_query_seconds_bucket{endpoint=~\"$endpoint\",smgr_query_type=\"get_page_at_lsn\"}[$__rate_interval])))",
          "legendFormat": "value"
        }
      ],
      "description": "End-to-end getpage latency at the pageserver, excluding the network hop from the compute."
    },
    {
      "type": "stat",
      "title": "wait_lsn p99",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(pageserver_wait_lsn_seconds_bucket{endpoint=~\"$endpoint\"}[$__rate_interval])))",
          "legendFormat": "value"
        }
      ],
      "description": "Time a request spent blocked waiting for its LSN to be ingested. This is ingest lag showing up as read latency."
    },
    {
      "type": "stat",
      "title": "Throttled req/s",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(pageserver_tenant_throttling_count_total{endpoint=~\"$endpoint\"}[$__rate_interval]))",
          "legendFormat": "value"
        }
      ],
      "description": "Requests the pageserver deliberately delayed (per-tenant rate limiting)."
    },
    {
      "type": "stat",
      "title": "pagestream error rate",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 2
              },
              {
                "color": "red",
                "value": 10
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * sum(rate(pageserver_pagestream_handler_results_total{endpoint=~\"$endpoint\",outcome!=\"success\"}[$__rate_interval]) or rate(pageserver_pagestream_handler_results_total{endpoint=~\"$endpoint\"}[$__rate_interval]) * 0) / clamp_min(sum(rate(pageserver_pagestream_handler_results_total{endpoint=~\"$endpoint\"}[$__rate_interval])), 1)",
          "legendFormat": "value"
        }
      ]
    },
