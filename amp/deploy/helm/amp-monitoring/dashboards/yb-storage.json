{
  "title": "amp — storage engine (YugabyteDB backend)",
  "uid": "amp-yb-storage",
  "tags": [
    "amp",
    "pageserver",
    "storage",
    "yb"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "The pageserver's YB-backed page store: the fast-cache read path, the materializer and pagewriter write path, GC drain, and the YB client underneath. No Neon analogue — amp replaced the layered store, so none of Neon's layer/page-cache panels apply here.",
  "templating": {
    "list": [
      {
        "name": "endpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(pg_up, endpoint)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Headline",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "fast_cache read share",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 98
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "100 * sum(rate(pageserver_yb_page_reads_total{endpoint=~\"$endpoint\",path=\"fast_cache\"}[$__rate_interval])) / clamp_min(sum(rate(pageserver_yb_page_reads_total{endpoint=~\"$endpoint\"}[$__rate_interval])), 1)",
          "legendFormat": "value"
        }
      ],
      "description": "Share of page reads served from the pageserver's fast cache rather than going to YB (yb_blend)."
    },
    {
      "type": "stat",
      "title": "Write amplification (stored/logical)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(pageserver_yb_payload_stored_bytes_total{endpoint=~\"$endpoint\"}[$__rate_interval])) / clamp_min(sum(rate(pageserver_yb_payload_logical_bytes_total{endpoint=~\"$endpoint\"}[$__rate_interval])), 1)",
          "legendFormat": "value"
        }
      ],
      "description": "Bytes actually stored per logical byte ingested. Above 1 is overhead the engine adds."
    },
    {
      "type": "stat",
      "title": "Materializer queue depth (max)",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "max"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(pageserver_yb_materializer_queue_depth{endpoint=~\"$endpoint\"})",
          "legendFormat": "value"
        }
      ],
      "description": "Backlog waiting to be materialized. Sustained growth means the materializer is not keeping up with ingest."
    },
    {
      "type": "stat",
      "title": "GC drain lag",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
