      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(pageserver_yb_gc_drain_lag_bytes{endpoint=~\"$endpoint\"})",
          "legendFormat": "value"
        }
      ],
      "description": "How far behind the GC drain is. Unbounded growth = dead page versions accumulating."
    },
