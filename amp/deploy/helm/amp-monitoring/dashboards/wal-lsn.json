{
  "title": "amp — WAL ingest & LSN lag",
  "uid": "amp-wal-lsn",
  "tags": [
    "amp",
    "wal",
    "safekeeper",
    "pageserver"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "description": "The safekeeper → pageserver WAL pipeline: how far ingest trails the committed LSN, throughput at each hop, and receiver health. LSN differences are byte offsets, so a lag is a byte count.",
  "templating": {
    "list": [
      {
        "name": "endpoint",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "victoriametrics"
        },
        "query": "label_values(pg_up, endpoint)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Headline",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "stat",
      "title": "Ingest lag (commit → last_record), max",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "max"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(max by (endpoint, branch_id) (safekeeper_commit_lsn{endpoint=~\"$endpoint\"}) - max by (endpoint, branch_id) (pageserver_last_record_lsn{endpoint=~\"$endpoint\"}))",
          "legendFormat": "value"
        }
      ],
      "description": "Bytes of committed WAL the pageserver has not ingested yet. The number a reader waits on."
    },
    {
      "type": "stat",
      "title": "WAL ingest rate",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(pageserver_wal_ingest_bytes_received_total{endpoint=~\"$endpoint\"}[$__rate_interval]))",
          "legendFormat": "value"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Corruption detected",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "max"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max(safekeeper_ps_corruption_detected{endpoint=~\"$endpoint\"})",
          "legendFormat": "value"
        }
      ],
      "description": "safekeeper_ps_corruption_detected. Anything above 0 is an incident, not a trend."
    },
    {
      "type": "stat",
      "title": "walreceiver reconnects/s",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum(rate(pageserver_walreceiver_switches_total{endpoint=~\"$endpoint\"}[$__rate_interval]))",
          "legendFormat": "value"
        }
      ],
      "description": "Connection churn between pageserver and safekeeper. Steady churn means neither side is stable."
    },
    {
      "type": "row",
      "title": "LSN lag",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Ingest lag: commit_lsn − last_record_lsn",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 8,
            "showPoints": "never"
          },
          "unit": "bytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (endpoint, branch_id) (safekeeper_commit_lsn{endpoint=~\"$endpoint\"}) - max by (endpoint, branch_id) (pageserver_last_record_lsn{endpoint=~\"$endpoint\"})",
          "legendFormat": "{{endpoint}} / {{branch_id}}"
        }
      ],
      "description": "The pipeline's headline lag: WAL the safekeeper has committed but the pageserver has not applied."
    },
    {
      "type": "timeseries",
      "title": "Safekeeper internal lag: commit_lsn − consistent_lsn",
      "gridPos": {
        "h": 8,
