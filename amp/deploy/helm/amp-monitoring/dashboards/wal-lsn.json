    {
      "type": "timeseries",
      "title": "WAL batch shape & insert latency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 31
      },
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
