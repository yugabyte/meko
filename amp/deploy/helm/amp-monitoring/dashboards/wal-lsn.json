          },
          "expr": "max by (endpoint, branch_id) (safekeeper_commit_lsn{endpoint=~\"$endpoint\"}) - max by (endpoint, branch_id) (safekeeper_consistent_lsn{endpoint=~\"$endpoint\"})",
          "legendFormat": "{{endpoint}} / {{branch_id}}"
        }
