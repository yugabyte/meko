      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "sum by (endpoint) (rate(safekeeper_yb_wal_batch_rows_sum{endpoint=~\"$endpoint\"}[$__rate_interval])) / clamp_min(sum by (endpoint) (rate(safekeeper_yb_wal_batch_rows_count{endpoint=~\"$endpoint\"}[$__rate_interval])), 1)",
