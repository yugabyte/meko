          "expr": "sum by (endpoint) (rate(safekeeper_yb_wal_batch_bytes_sum{endpoint=~\"$endpoint\"}[$__rate_interval])) / clamp_min(sum by (endpoint) (rate(safekeeper_yb_wal_batch_bytes_count{endpoint=~\"$endpoint\"}[$__rate_interval])), 1)",
          "legendFormat": "bytes/batch {{endpoint}}"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(safekeeper_yb_wal_insert_seconds_bucket{endpoint=~\"$endpoint\"}[$__rate_interval])))",
          "legendFormat": "p99 insert (s)"
        }
