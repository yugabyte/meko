   "datasource": {
    "type": "prometheus",
    "uid": "lru-prom"
   },
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "none",
    "textMode": "value"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "mappings": [
      {
       "type": "value",
       "options": {
        "1": {
         "text": "OK",
         "color": "green"
        },
        "0.5": {
         "text": "WARN",
         "color": "orange"
        },
        "0": {
         "text": "FAIL",
         "color": "red"
        },
        "-1": {
         "text": "ERR",
         "color": "purple"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "purple",
        "value": null
       },
       {
        "color": "red",
        "value": 0
       },
       {
        "color": "orange",
        "value": 0.5
       },
       {
        "color": "green",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max(lru_overall_status{lru=\"$lru\"})",
     "datasource": {
      "type": "prometheus",
      "uid": "lru-prom"
