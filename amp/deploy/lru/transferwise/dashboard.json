     "text": "transferwise",
     "value": "transferwise"
    }
   },
   {
    "name": "endpoint",
    "label": "endpoint",
    "type": "query",
    "datasource": {
     "type": "prometheus",
     "uid": "lru-prom"
    },
    "query": "query_result(amp_endpoint_info{default=\"true\",pool=\"lru-transferwise\"})",
    "refresh": 2,
    "sort": 1,
    "regex": "/endpoint=\"(?<value>[^\"]+)\"/",
    "hide": 2
   }
  ]
 },
