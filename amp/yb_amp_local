#!/usr/bin/env bash
# Convenience wrapper: run the debug-profile yb_amp_local binary.
#
# Execs the already-built binary from any working directory. For the
# release binary use the sibling `yb_amp_local_release` script.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$REPO/target/debug/yb_amp_local"

[[ -x "$BIN" ]] || {
  echo "yb_amp_local debug binary not found at $BIN" >&2
  echo "build it first: go build -C controller -o target/debug/yb_amp_local ./local/cmd/yb_amp_local" >&2
  exit 1
}

# The launcher defaults POSTGRES_DISTRIB_DIR to $cwd/pg_install — the release
# bundle's layout, not a tree a checkout has — so the repo wrappers name the
# tree matching their profile. An ambient value wins, for a caller pointing at a
# tree it built elsewhere.
export POSTGRES_DISTRIB_DIR="${POSTGRES_DISTRIB_DIR:-$REPO/pg_install-debug}"

exec "$BIN" "$@"
