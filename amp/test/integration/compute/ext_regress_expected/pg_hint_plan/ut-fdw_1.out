-- directory paths and dlsuffix are passed to us in environment variables
\getenv abs_srcdir PG_ABS_SRCDIR
\set filename :abs_srcdir '/data/data.csv'
LOAD 'pg_hint_plan';
SET search_path TO public;
SET pg_hint_plan.debug_print TO on;
SET client_min_messages TO LOG;
SET pg_hint_plan.enable_hint TO on;
CREATE EXTENSION file_fdw;
ERROR:  extension "file_fdw" is not available
HINT:  The extension must first be installed on the system where PostgreSQL is running.
CREATE SERVER file_server FOREIGN DATA WRAPPER file_fdw;
ERROR:  foreign-data wrapper "file_fdw" does not exist
CREATE USER MAPPING FOR PUBLIC SERVER file_server;
ERROR:  server "file_server" does not exist
CREATE FOREIGN TABLE ft1 (id int, val int) SERVER file_server OPTIONS (format 'csv', filename :'filename');
ERROR:  server "file_server" does not exist
-- foreign table test
SELECT * FROM ft1;
ERROR:  relation "ft1" does not exist
LINE 1: SELECT * FROM ft1;
                      ^
\t
SELECT explain_filter('
EXPLAIN (COSTS false) SELECT * FROM s1.t1, ft1 ft_1, ft1 ft_2 WHERE t1.c1 = ft_1.id AND t1.c1 = ft_2.id;
');
ERROR:  relation "ft1" does not exist
LINE 2: EXPLAIN (COSTS false) SELECT * FROM s1.t1, ft1 ft_1, ft1 ft_...
                                                   ^
QUERY:  
EXPLAIN (COSTS false) SELECT * FROM s1.t1, ft1 ft_1, ft1 ft_2 WHERE t1.c1 = ft_1.id AND t1.c1 = ft_2.id;

