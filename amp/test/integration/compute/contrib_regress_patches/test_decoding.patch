Every yb-amp compute holds the walproposer's physical slot, wal_proposer_slot,
so it shows in each pg_replication_slots listing, with a pid and LSN that vary
per run. Filter it out of the listings; the decoding output is untouched.

--- a/sql/ddl.sql
+++ b/sql/ddl.sql
@@ -30,7 +30,7 @@
     NOT catalog_xmin IS NULL AS catalog_xmin_set,
     xmin IS NULl  AS data_xmin_not_set,
     pg_wal_lsn_diff(restart_lsn, '0/01000000') > 0 AS some_wal
-FROM pg_replication_slots;
+FROM pg_replication_slots WHERE slot_name <> 'wal_proposer_slot';
 
 /*
  * Check that changes are handled correctly when interleaved with ddl
@@ -441,5 +441,5 @@
 
 /* check that the slot is gone */
 \x
-SELECT * FROM pg_replication_slots;
+SELECT * FROM pg_replication_slots WHERE slot_name <> 'wal_proposer_slot';
 \x
