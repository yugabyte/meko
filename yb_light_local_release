#!/usr/bin/env bash
# Convenience wrapper: run the release-profile yb_light_local binary.
#
# Same as the sibling `yb_light_local` script but targets
# target/release/. For day-to-day dev iteration prefer the debug
# wrapper; use this when you specifically need the optimized build.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN="$REPO/target/release/yb_light_local"

[[ -x "$BIN" ]] || {
    echo "yb_light_local release binary not found at $BIN" >&2
    echo "build it first: cargo build --release --bin yb_light_local" >&2
    exit 1
}

exec "$BIN" "$@"
