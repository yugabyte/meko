# Build the reconcile-agent image — the standalone agent that converges an amp
# environment to YCP's desired state (ycp/cmd/reconcile-agent). Built and pushed
# as quay.io/yugabyte/ycp-reconciler-agent by build-reconciler-agent-image.sh.
#
# Cross-compiles: the builder runs on the BUILD platform and Go emits a binary
# for the TARGET one, so `--platform linux/amd64` from an arm64 laptop compiles
# natively instead of under emulation. On an amd64 CI runner both platforms are
# identical.
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS build
ARG TARGETOS=linux
ARG TARGETARCH

# helm, for the `controller` desired-state kind: the agent helm-upgrades the
# release it is itself a member of. Fetched here rather than in the final stage
# because distroless has no shell to untar with, and for the TARGET arch — the
# controller image's recipe hardcodes linux-amd64, which would silently put an
# amd64 helm in an arm64 image. get.helm.sh publishes a checksum beside each
# tarball, so verify it rather than carrying that gap over too.
ARG HELM_VERSION=3.18.6
RUN set -e \
    && arch="${TARGETARCH:-$(go env GOARCH)}" \
    && url="https://get.helm.sh/helm-v${HELM_VERSION}-linux-${arch}.tar.gz" \
    && wget -qO /tmp/helm.tgz "$url" \
    && wget -qO /tmp/helm.sha256 "${url}.sha256sum" \
    && echo "$(cut -d' ' -f1 /tmp/helm.sha256)  /tmp/helm.tgz" | sha256sum -c - \
    && tar -xzf /tmp/helm.tgz -C /tmp "linux-${arch}/helm" \
    && mv "/tmp/linux-${arch}/helm" /helm

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags "-s -w" -o /reconcile-agent ./cmd/reconcile-agent
FROM gcr.io/distroless/static:nonroot
COPY --from=build /reconcile-agent /reconcile-agent
COPY --from=build /helm /usr/local/bin/helm
# helm puts its cache, config and repository data under $HOME, which is
# /home/nonroot here and not writable by UID 65532. /tmp is.
ENV HELM_CACHE_HOME=/tmp/helm/cache \
    HELM_CONFIG_HOME=/tmp/helm/config \
    HELM_DATA_HOME=/tmp/helm/data
ENTRYPOINT ["/reconcile-agent"]
