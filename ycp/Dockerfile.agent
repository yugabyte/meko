# Build the meko-agent (BYOC pull agent) image.
# Built and pushed as 161908593886.dkr.ecr.us-east-2.amazonaws.com/meko/meko-agent.
# Referenced by the meko chart's `agent` component (agent.image.repository).
# Cross-compiles: the builder runs on the BUILD platform and Go emits a binary for
# the TARGET one. `--platform linux/amd64` from an arm64 laptop therefore compiles
# natively instead of running the whole toolchain under emulation. On an amd64 CI
# runner the two platforms are identical and this renders exactly as before.
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS build
ARG TARGETOS=linux
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags "-s -w" -o /agent ./cmd/agent
FROM gcr.io/distroless/static:nonroot
COPY --from=build /agent /agent
ENTRYPOINT ["/agent"]
