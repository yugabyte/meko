{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yugabyte/agent-k-local/docs/call-home-report.schema.json",
  "title": "Kode CallHomeReport",
  "description": "The daily usage report a Kode release install sends to YugabyteDB's call home service, as the payload of yugabyted's envelope. Schema 1. Only counts, enums and version strings: no names, paths or free text.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "installId", "sentAt", "install", "totals", "days"],
  "properties": {
    "schema": { "const": 1 },
    "installId": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "sentAt": { "type": "string", "format": "date-time" },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "channel", "platform", "arch", "node", "access", "service", "meko", "firstDay"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "channel": { "enum": ["stable", "prerelease", "off"], "description": "Always stable from versions Meko updates (Meko's own channel decides); older ones sent their own [update] channel." },
        "platform": { "enum": ["aix", "android", "cygwin", "darwin", "freebsd", "haiku", "linux", "netbsd", "openbsd", "sunos", "win32"] },
        "arch": { "enum": ["arm", "arm64", "ia32", "loong64", "mips", "mipsel", "ppc", "ppc64", "riscv64", "s390", "s390x", "x64"] },
        "node": { "$ref": "#/$defs/version" },
        "tmux": { "$ref": "#/$defs/optionalVersion", "description": "Sent only by versions before the session host (no longer by current ones); kept so their reports still validate." },
        "claudeCode": { "$ref": "#/$defs/optionalVersion" },
        "kiro": { "$ref": "#/$defs/optionalVersion", "description": "Kiro CLI's version; left out while Kiro is off or unreadable." },
        "opencode": { "$ref": "#/$defs/optionalVersion", "description": "OpenCode's version; left out while OpenCode is off or unreadable." },
        "access": { "enum": ["local", "remote", "meko"], "description": "meko: the Meko on this computer serves Kode to browsers, with its own access setting. local and remote are from versions that served browsers themselves; kept so their reports still validate." },
        "service": { "enum": ["systemd", "launchd", "none"] },
        "meko": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "keySource", "sharing"],
          "properties": {
            "enabled": { "type": "boolean" },
            "keySource": { "enum": ["meko", "local", "config", "env", "claude", "none"] },
            "sharing": { "enum": ["api", "none"] }
          }
        },
        "firstDay": { "$ref": "#/$defs/day" }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projects", "sessions", "shipped", "fileTypes", "tokens", "worktrees", "meko", "mekoFirstTurn"],
      "properties": {
        "projects": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "current": { "$ref": "#/$defs/count" },
            "deleted": { "$ref": "#/$defs/count" },
            "withDatapack": { "$ref": "#/$defs/count" },
            "sharedDatapacks": { "$ref": "#/$defs/count" },
            "repos": { "$ref": "#/$defs/count" }
          }
        },
        "sessions": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "total": { "$ref": "#/$defs/count" },
            "open": { "$ref": "#/$defs/count" },
            "archived": { "$ref": "#/$defs/count" },
            "byKind": { "$ref": "#/$defs/kindCounts" },
            "byHarness": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "claude": { "$ref": "#/$defs/count" },
                "opencode": { "$ref": "#/$defs/count" },
                "kiro": { "$ref": "#/$defs/count" }
              }
            },
            "openByStage": { "$ref": "#/$defs/stageCounts" }
          }
        },
        "shipped": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mergedPrs": { "$ref": "#/$defs/count" },
            "directPushes": { "$ref": "#/$defs/count" },
            "directCommits": { "$ref": "#/$defs/count" },
            "prCommits": { "$ref": "#/$defs/count" },
            "prAdditions": { "$ref": "#/$defs/count" },
            "prDeletions": { "$ref": "#/$defs/count" }
          }
        },
        "fileTypes": { "type": "array", "maxItems": 26, "items": { "$ref": "#/$defs/fileType" } },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input": { "$ref": "#/$defs/count" },
            "output": { "$ref": "#/$defs/count" },
            "cacheRead": { "$ref": "#/$defs/count" },
            "cacheWrite": { "$ref": "#/$defs/count" },
            "messages": { "$ref": "#/$defs/count" }
          }
        },
        "worktrees": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "idle": { "$ref": "#/$defs/count" }
          }
        },
        "meko": { "$ref": "#/$defs/meko" },
        "mekoFirstTurn": { "$ref": "#/$defs/mekoFirstTurn" }
      }
    },
    "days": {
      "type": "array",
      "maxItems": 31,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["day"],
        "properties": {
          "day": { "$ref": "#/$defs/day" },
          "activeProjects": { "$ref": "#/$defs/count" },
          "activeSessions": { "$ref": "#/$defs/count" },
          "messages": { "$ref": "#/$defs/count" },
          "projectsCreated": { "$ref": "#/$defs/count" },
          "projectsDeleted": { "$ref": "#/$defs/count" },
          "sessionsCreated": { "$ref": "#/$defs/kindCounts" },
          "sessionsArchived": { "$ref": "#/$defs/count" },
          "stageEntries": { "$ref": "#/$defs/stageCounts" },
          "prsOpened": { "$ref": "#/$defs/count" },
          "prsMerged": { "$ref": "#/$defs/count" },
          "prCommits": { "$ref": "#/$defs/count" },
          "prAdditions": { "$ref": "#/$defs/count" },
          "prDeletions": { "$ref": "#/$defs/count" },
          "directPushes": { "$ref": "#/$defs/count" },
          "directCommits": { "$ref": "#/$defs/count" },
          "reviews": { "$ref": "#/$defs/count" },
          "ciFailures": { "$ref": "#/$defs/count" },
          "commentBatches": { "$ref": "#/$defs/count" },
          "recoveries": { "$ref": "#/$defs/count" },
          "resumes": { "$ref": "#/$defs/count" },
          "worktreesReused": { "$ref": "#/$defs/count" },
          "fileTypes": { "type": "array", "maxItems": 26, "items": { "$ref": "#/$defs/fileType" } },
          "tokensByModel": { "type": "array", "maxItems": 20, "items": { "$ref": "#/$defs/modelTokens" } },
          "meko": { "$ref": "#/$defs/meko" },
          "kiro": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sessionsCreated", "turns", "credits"],
            "properties": {
              "sessionsCreated": { "$ref": "#/$defs/count" },
              "turns": { "$ref": "#/$defs/count" },
              "credits": { "type": "number", "minimum": 0, "maximum": 1000000000 }
            }
          },
          "askAgentk": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asks", "failed", "actions"],
            "properties": {
              "asks": { "$ref": "#/$defs/count" },
              "failed": { "$ref": "#/$defs/count" },
              "actions": { "$ref": "#/$defs/count" }
            }
          },
          "codeReview": { "$ref": "#/$defs/codeReview" }
        }
      }
    }
  },
  "$defs": {
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740992 },
    "day": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "version": { "type": "string", "pattern": "^v?[0-9]{1,9}(\\.[0-9]{1,9}){0,3}[a-z]?(-(alpha|beta|rc|pre|dev|canary|nightly|next|[0-9]{1,9})(\\.[0-9]{1,9}){0,3})?(\\+[0-9]{1,14})?$" },
    "optionalVersion": { "type": "string", "pattern": "^$|^v?[0-9]{1,9}(\\.[0-9]{1,9}){0,3}[a-z]?(-(alpha|beta|rc|pre|dev|canary|nightly|next|[0-9]{1,9})(\\.[0-9]{1,9}){0,3})?(\\+[0-9]{1,14})?$" },
    "kindCounts": {
      "type": "object",
      "propertyNames": { "enum": ["explore", "plan", "quick", "review-pr"] },
      "maxProperties": 16,
      "additionalProperties": { "$ref": "#/$defs/count" }
    },
    "stageCounts": {
      "type": "object",
      "propertyNames": { "enum": ["explore", "design", "code", "pr", "review", "merge", "done", "reviewing-pr"] },
      "maxProperties": 16,
      "additionalProperties": { "$ref": "#/$defs/count" }
    },
    "fileType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ext", "files", "additions", "deletions"],
      "properties": {
        "ext": { "type": "string", "pattern": "^[a-z0-9]{1,10}$" },
        "files": { "$ref": "#/$defs/count" },
        "additions": { "$ref": "#/$defs/count" },
        "deletions": { "$ref": "#/$defs/count" }
      }
    },
    "modelTokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model"],
      "properties": {
        "model": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$" },
        "input": { "$ref": "#/$defs/count" },
        "output": { "$ref": "#/$defs/count" },
        "cacheRead": { "$ref": "#/$defs/count" },
        "cacheWrite": { "$ref": "#/$defs/count" },
        "messages": { "$ref": "#/$defs/count" }
      }
    },
    "toolCounts": {
      "type": "object",
      "propertyNames": { "enum": ["memory_search", "knowledgebase_search", "context_search", "memory_get_all", "memory_get_by_id", "conversation_get", "artifact_get", "memory_add", "memory_update", "memory_promote", "artifact_put", "conversation_add_message", "other"] },
      "maxProperties": 16,
      "additionalProperties": { "$ref": "#/$defs/count" }
    },
    "meko": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calls", "lookups", "found", "empty", "errors", "saves", "foundTokens", "byTool", "savings", "starts"],
      "properties": {
        "calls": { "$ref": "#/$defs/count" },
        "lookups": { "$ref": "#/$defs/count" },
        "found": { "$ref": "#/$defs/count" },
        "empty": { "$ref": "#/$defs/count" },
        "errors": { "$ref": "#/$defs/count" },
        "saves": { "$ref": "#/$defs/count" },
        "foundTokens": { "$ref": "#/$defs/count" },
        "byTool": { "$ref": "#/$defs/toolCounts" },
        "savings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["searches", "seeds", "tokens", "usdCents", "unpricedSearches", "unpricedSeeds"],
          "properties": {
            "searches": { "$ref": "#/$defs/count" },
            "seeds": { "$ref": "#/$defs/count" },
            "tokens": { "$ref": "#/$defs/count" },
            "usdCents": { "$ref": "#/$defs/count" },
            "unpricedSearches": { "$ref": "#/$defs/count" },
            "unpricedSeeds": { "$ref": "#/$defs/count" }
          }
        },
        "starts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["found", "empty", "error", "late", "ms"],
          "properties": {
            "found": { "$ref": "#/$defs/count" },
            "empty": { "$ref": "#/$defs/count" },
            "error": { "$ref": "#/$defs/count" },
            "late": { "$ref": "#/$defs/count" },
            "ms": { "$ref": "#/$defs/count" }
          }
        },
        "sentTokens": { "$ref": "#/$defs/count" },
        "sentByTool": { "$ref": "#/$defs/toolCounts" },
        "learn": { "$ref": "#/$defs/learn" },
        "agentk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["calls", "errors", "sentTokens", "ms", "byTool"],
          "properties": {
            "calls": { "$ref": "#/$defs/count" },
            "errors": { "$ref": "#/$defs/count" },
            "sentTokens": { "$ref": "#/$defs/count" },
            "ms": { "$ref": "#/$defs/count" },
            "byTool": {
              "type": "object",
              "propertyNames": { "pattern": "^[a-z][a-z_]{0,39}$" },
              "maxProperties": 10,
              "additionalProperties": { "$ref": "#/$defs/count" }
            }
          }
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["runs", "failures", "ms"],
          "properties": {
            "runs": { "$ref": "#/$defs/count" },
            "failures": { "$ref": "#/$defs/count" },
            "ms": { "$ref": "#/$defs/count" }
          }
        },
        "weak": { "$ref": "#/$defs/count", "description": "Sent only by versions before Meko judged searches itself (its Context Gaps); kept so their reports still validate." },
        "gaps": {
          "type": "object",
          "additionalProperties": false,
          "description": "Sent only by versions before Meko kept the questions it couldn't answer (its Context Gaps); kept so their reports still validate.",
          "required": ["dismissed", "taught"],
          "properties": {
            "dismissed": { "$ref": "#/$defs/count" },
            "taught": { "$ref": "#/$defs/count" }
          }
        }
      }
    },
    "tokens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "cacheRead", "cacheWrite", "messages"],
      "properties": {
        "input": { "$ref": "#/$defs/count" },
        "output": { "$ref": "#/$defs/count" },
        "cacheRead": { "$ref": "#/$defs/count" },
        "cacheWrite": { "$ref": "#/$defs/count" },
        "messages": { "$ref": "#/$defs/count" }
      }
    },
    "codeReview": {
      "type": "object",
      "additionalProperties": false,
      "description": "Local code reviews on a day: those started then, by their state now, and the tokens their sessions spent then; left out of a day with neither.",
      "required": ["runs", "byOutcome", "lgtm", "prs", "rounds", "candidates", "findings", "fixed", "declined", "tokens", "usdCents"],
      "properties": {
        "runs": { "$ref": "#/$defs/count" },
        "byOutcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["done", "failed", "cancelled", "running"],
          "properties": {
            "done": { "$ref": "#/$defs/count" },
            "failed": { "$ref": "#/$defs/count" },
            "cancelled": { "$ref": "#/$defs/count" },
            "running": { "$ref": "#/$defs/count" }
          }
        },
        "lgtm": { "$ref": "#/$defs/count" },
        "prs": { "$ref": "#/$defs/count" },
        "rounds": { "$ref": "#/$defs/count" },
        "candidates": { "$ref": "#/$defs/count" },
        "findings": {
          "type": "object",
          "additionalProperties": false,
          "required": ["blocker", "major", "minor"],
          "properties": {
            "blocker": { "$ref": "#/$defs/count" },
            "major": { "$ref": "#/$defs/count" },
            "minor": { "$ref": "#/$defs/count" }
          }
        },
        "fixed": { "$ref": "#/$defs/count" },
        "declined": { "$ref": "#/$defs/count" },
        "tokens": { "$ref": "#/$defs/tokens" },
        "usdCents": { "$ref": "#/$defs/count" },
        "credits": { "type": "number", "minimum": 0, "maximum": 1000000000 }
      }
    },
    "learn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs", "byTrigger", "byPath", "byOutcome", "candidates", "saves", "updates", "skips", "empty", "lookups", "errors", "sentTokens", "tokens", "usdCents"],
      "properties": {
        "runs": { "$ref": "#/$defs/count" },
        "byTrigger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["merge", "manual"],
          "properties": { "merge": { "$ref": "#/$defs/count" }, "manual": { "$ref": "#/$defs/count" }, "discard": { "$ref": "#/$defs/count" } }
        },
        "byPath": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mod", "turn", "none"],
          "properties": { "mod": { "$ref": "#/$defs/count" }, "turn": { "$ref": "#/$defs/count" }, "none": { "$ref": "#/$defs/count" } }
        },
        "byOutcome": {
          "type": "object",
          "additionalProperties": false,
          "required": ["done", "failed", "interrupted", "skipped"],
          "properties": {
            "done": { "$ref": "#/$defs/count" },
            "failed": { "$ref": "#/$defs/count" },
            "interrupted": { "$ref": "#/$defs/count" },
            "skipped": { "$ref": "#/$defs/count" }
          }
        },
        "candidates": { "$ref": "#/$defs/count" },
        "saves": { "$ref": "#/$defs/count" },
        "updates": { "$ref": "#/$defs/count" },
        "skips": { "$ref": "#/$defs/count" },
        "empty": { "$ref": "#/$defs/count" },
        "taught": { "$ref": "#/$defs/count" },
        "dismissed": { "$ref": "#/$defs/count" },
        "lookups": { "$ref": "#/$defs/count" },
        "errors": { "$ref": "#/$defs/count" },
        "sentTokens": { "$ref": "#/$defs/count" },
        "tokens": {
          "type": "object",
          "additionalProperties": false,
          "required": ["extract", "dedup", "turn"],
          "properties": {
            "extract": { "$ref": "#/$defs/tokens" },
            "dedup": { "$ref": "#/$defs/tokens" },
            "turn": { "$ref": "#/$defs/tokens" }
          }
        },
        "usdCents": { "$ref": "#/$defs/count" }
      }
    },
    "mekoFirstTurn": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sessions", "startSearches", "searchedTokens", "seedTokens"],
      "properties": {
        "sessions": { "$ref": "#/$defs/count" },
        "startSearches": { "$ref": "#/$defs/count" },
        "searchedTokens": { "$ref": "#/$defs/count" },
        "seedTokens": { "$ref": "#/$defs/count" }
      }
    }
  }
}
