#!/bin/sh
# Kode launcher, installed as <KODE_HOME>/app/<version>/bin/me_kode (and as bin/me_koder and
# bin/agentk, its names before, which services installed then and older Mekos still run).
#
# Runs the bundled Node on the bundled server. The Node is node/bin/me_kode, so the kernel names
# Kode's processes me_kode (ps, top, Activity Monitor), not node.
#
# `serve` and `host` go through Meko's launcher (`meko _launch`), which runs this file again with
# MEKO_LAUNCHED set. For `serve` Meko runs the probation of a version it just updated to: it counts
# the version's starts, rolls back to the version before after three failed ones, takes a clean stop
# off the count, and finishes the update once the version has run 5 minutes. For both, it marks the
# version's folder in use while they run, so Meko never deletes the folder a running session host
# started from.
set -eu

# Resolve our real location, following symlinks (~/.local/bin -> app/current -> app/<ver>).
self=$0
while [ -h "$self" ]; do
  dir=$(cd -P "$(dirname "$self")" && pwd)
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$dir/$link ;;
  esac
done
bin_dir=$(cd -P "$(dirname "$self")" && pwd)
KODE_APP_DIR=$(cd -P "$bin_dir/.." && pwd)
KODE_VERSION=$(cat "$KODE_APP_DIR/VERSION" 2>/dev/null || echo unknown)
export KODE_APP_DIR KODE_VERSION

node="$KODE_APP_DIR/node/bin/me_kode"
cli="$KODE_APP_DIR/lib/dist/server/cli.js"

# Meko runs the probation of a new version (counting starts, rolling back, finishing the update);
# without a Meko that can, the server runs anyway.
if [ -z "${MEKO_LAUNCHED:-}" ]; then
  case "${1:-}" in
    serve|host)
      meko=$(command -v meko 2>/dev/null || true)
      [ -n "$meko" ] || meko=$HOME/.local/bin/meko
      [ -x "$meko" ] || meko=${XDG_DATA_HOME:-$HOME/.local/share}/meko/app/current/bin/meko
      if [ -x "$meko" ] && "$meko" _launch --supported >/dev/null 2>&1; then
        # A Meko from before it called Kode kode knows it only by its old name, agentk.
        name=agentk
        "$meko" _launch --supported kode >/dev/null 2>&1 && name=kode
        exec "$meko" _launch "$name" "$bin_dir/me_kode" "$@"
      fi
      echo "me_kode: no meko with _launch was found, so a failed update won't roll back" >&2
      ;;
  esac
fi

exec "$node" --disable-warning=ExperimentalWarning "$cli" "$@"
