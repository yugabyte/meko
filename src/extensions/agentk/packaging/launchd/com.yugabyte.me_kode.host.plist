<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Kode session host (holds every Claude session). Written by `meko kode install`. -->
<!-- It runs the version that was current when it started and keeps running across updates:
     restarting it ends every Claude session (the server resumes them). -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@HOST_ID@</string>
  <!-- service/me_kode in the home execs app/current/bin/me_kode: an update replaces that file, never
       this one, so macOS doesn't announce Kode as a new background item each time. -->
  <key>ProgramArguments</key>
  <array>
    <string>@KODE_HOME@/service/me_kode</string>
    <string>host</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>KODE_HOME</key>
    <string>@KODE_HOME@</string>
    <!-- launchd sets no locale; Claude needs a UTF-8 one to draw its UI. -->
    <key>LANG</key>
    <string>en_US.UTF-8</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>2</integer>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>/dev/null</string>
  <key>StandardErrorPath</key>
  <string>@KODE_HOME@/logs/launchd-host.log</string>
</dict>
</plist>
