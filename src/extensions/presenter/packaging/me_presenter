#!/bin/sh
# Presenter's launcher, in a release as presenter-<version>/bin/me_presenter (and as
# bin/meko_presenter, its name before, which older Mekos run). Meko installs releases
# as <Meko's data folder>/extensions/presenter/app/<version>, with app/current and
# ~/.local/bin/me_presenter pointing at the one in use (meko extension install, meko
# extension update).
#
# Runs the bundled Node (node/bin/me_presenter, so the kernel names the process me_presenter, not
# node) on the bundled server, with PRESENTER_APP_DIR naming this release's folder
# and PRESENTER_LAUNCHER this file (`me_presenter start` runs `serve` through it). It hands `serve`
# to Meko (`meko _launch presenter`), which counts the starts of a version on probation after an
# update, rolls back one that fails three times, takes a clean stop off the count, and finishes the
# update once the version has served 5 minutes (src/meko/internal/update/pending.go, the rules Meko
# follows for itself). Meko runs this file again with MEKO_LAUNCHED set, and then it runs Node. With
# no meko that has `_launch`, it runs Node itself, and a failed update doesn't roll back.
set -eu

# Resolve our real location, following symlinks (~/.local/bin -> app/current -> app/<version>).
self=$0
while [ -h "$self" ]; do
  dir=$(cd -P "$(dirname "$self")" && pwd)
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$dir/$link ;;
  esac
done
bin_dir=$(cd -P "$(dirname "$self")" && pwd)
PRESENTER_APP_DIR=$(cd -P "$bin_dir/.." && pwd)
PRESENTER_LAUNCHER=$bin_dir/me_presenter
export PRESENTER_APP_DIR PRESENTER_LAUNCHER

node="$PRESENTER_APP_DIR/node/bin/me_presenter"
cli="$PRESENTER_APP_DIR/lib/dist/server/cli.js"

if [ -z "${MEKO_LAUNCHED:-}" ] && [ "${1:-}" = "serve" ]; then
  # Meko's launcher, wherever the service's short PATH leaves it.
  meko=$(command -v meko 2>/dev/null || true)
  [ -n "$meko" ] || meko=$HOME/.local/bin/meko
  [ -x "$meko" ] || meko=${XDG_DATA_HOME:-$HOME/.local/share}/meko/app/current/bin/meko
  if [ -x "$meko" ] && "$meko" _launch --supported >/dev/null 2>&1; then
    exec "$meko" _launch presenter "$PRESENTER_LAUNCHER" "$@"
  fi
  echo "me_presenter: no meko with _launch was found, so a failed update won't roll back" >&2
fi

exec "$node" --disable-warning=ExperimentalWarning "$cli" "$@"
