{"title": "amp \u2014 Storage layer", "uid": "amp-storage", "tags": ["amp", "storage"], "timezone": "browser", "schemaVersion": 39, "refresh": "30s", "time": {"from": "now-1h", "to": "now"}, "templating": {"list": [{"name": "endpoint", "type": "query", "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "query": "label_values(safekeeper_active_timelines, endpoint)", "refresh": 2, "includeAll": true, "multi": true, "current": {"text": "All", "value": "$__all"}}]}, "panels": [{"type": "stat", "title": "Storage-controller: branches", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {}}, "targets": [{"expr": "max(storage_controller_branches)", "datasource": {"type": "prometheus", "uid": "victoriametrics"}}]}, {"type": "stat", "title": "Pageserver nodes", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {}}, "targets": [{"expr": "max(storage_controller_pageserver_nodes)", "datasource": {"type": "prometheus", "uid": "victoriametrics"}}]}, {"type": "stat", "title": "Safekeeper active timelines", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {}}, "targets": [{"expr": "sum(safekeeper_active_timelines{endpoint=~\"$endpoint\"})", "datasource": {"type": "prometheus", "uid": "victoriametrics"}}]}, {"type": "stat", "title": "Connected computes", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {}}, "targets": [{"expr": "sum(safekeeper_connected_computes{endpoint=~\"$endpoint\"})", "datasource": {"type": "prometheus", "uid": "victoriametrics"}}]}, {"type": "timeseries", "title": "storage_controller HTTP req/s by status", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "reqps"}}, "targets": [{"expr": "sum by (status) (rate(storage_controller_http_request_status_total[5m]))", "legendFormat": "{{status}}", "datasource": {"type": "prometheus", "uid": "victoriametrics"}}]}, {"type": "timeseries", "title": "storage_controller DB query latency p95 (s)", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "s"}}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(storage_controller_database_query_latency_bucket[5m])))", "legendFormat": "p95", "datasource": {"type": "prometheus", "uid": "victoriametrics"}}]}, {"type": "timeseries", "title": "Safekeeper WAL flush throughput (bytes/s)", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "Bps"}}, "targets": [{"expr": "sum by (endpoint) (deriv(safekeeper_flush_lsn{endpoint=~\"$endpoint\"}[5m]))", "legendFormat": "{{endpoint}}", "datasource": {"type": "prometheus", "uid": "victoriametrics"}}]}, {"type": "timeseries", "title": "Safekeeper disk usage (bytes)", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "bytes"}}, "targets": [{"expr": "sum by (endpoint) (safekeeper_disk_usage_bytes{endpoint=~\"$endpoint\"})", "legendFormat": "{{endpoint}}", "datasource": {"type": "prometheus", "uid": "victoriametrics"}}]}, {"type": "timeseries", "title": "Pageserver active storage operations", "gridPos": {"x": 0, "y": 20, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {}}, "targets": [{"expr": "sum by (endpoint) (pageserver_active_storage_operations_count{endpoint=~\"$endpoint\"})", "legendFormat": "{{endpoint}}", "datasource": {"type": "prometheus", "uid": "victoriametrics"}}]}, {"type": "timeseries", "title": "compute_ctl: PG downtime (ms / 5m)", "gridPos": {"x": 12, "y": 20, "w": 12, "h": 8}, "datasource": {"type": "prometheus", "uid": "victoriametrics"}, "fieldConfig": {"defaults": {"unit": "ms"}}, "targets": [{"expr": "sum by (endpoint) (increase(compute_pg_downtime_ms_total{endpoint=~\"$endpoint\"}[5m]))", "legendFormat": "{{endpoint}}", "datasource": {"type": "prometheus", "uid": "victoriametrics"}}]}]}