{
  "apiVersion": "operator.yugabyte.io/v1alpha1",
  "kind": "YBProvider",
  "metadata": {
    "labels": {
      "app.kubernetes.io/managed-by": "meko-foundation"
    },
    "name": "foundation",
    "namespace": "amp"
  },
  "spec": {
    "cloudInfo": {
      "kubernetesImageRegistry": "quay.io/yugabyte/yugabyte-itest",
      "kubernetesProvider": "gke"
    },
    "regions": [
      {
        "code": "us-west1",
        "zones": [
          {
            "cloudInfo": {
              "certManagerIssuerGroup": "cert-manager.io",
              "certManagerIssuerKind": "ClusterIssuer",
              "certManagerIssuerName": "amp-ca",
              "kubeNamespace": "amp",
              "kubernetesStorageClass": "yb-standard"
            },
            "code": "us-west1-b"
          }
        ]
      }
    ]
  }
}
