{
  "apiVersion": "operator.yugabyte.io/v1alpha1",
  "kind": "YBUniverse",
  "metadata": {
    "labels": {
      "app.kubernetes.io/managed-by": "meko-foundation"
    },
    "name": "foundation",
    "namespace": "amp"
  },
  "spec": {
    "enableClientToNodeEncrypt": false,
    "enableLoadBalancer": true,
    "enableNodeToNodeEncrypt": false,
    "kubernetesOverrides": {
      "serviceEndpoints": [
        {
          "app": "yb-tserver",
          "name": "yb-tserver-conn",
          "ports": {
            "tcp-rpc-port": "9100",
            "tcp-ysql-port": "5433"
          },
          "scope": "Namespaced",
          "type": "ClusterIP"
        }
      ]
    },
    "numNodes": 3,
    "placementInfo": {
      "regions": [
        {
          "code": "us-west1",
          "zones": [
            {
              "code": "us-west1-b",
              "numNodes": 3
            }
          ]
        }
      ]
    },
    "providerName": "foundation",
    "replicationFactor": 3,
    "telemetry": {
      "metrics": {
        "collectionLevel": "MINIMAL",
        "exporters": [
          {
            "additionalTags": {
              "account_id": "3f2b1c00-0000-0000-0000-000000000009",
              "environment_id": "acme-prod",
              "source": "amp"
            },
            "telemetryProvider": "byoc-metrics"
          }
        ],
        "scrapeConfigTargets": [
          "MASTER_EXPORT",
          "TSERVER_EXPORT",
          "YSQL_EXPORT"
        ]
      }
    },
    "tserverVolume": {
      "volumeSize": 100
    },
    "universeName": "foundation",
    "ybSoftwareVersion": "2026.1.2.0-b137"
  }
}
