{
  "name": "docs",
  "version": "1.0.0",
  "main": "public/index.html",
  "scripts": {
    "dev": "run-p webpack:watch hugo:dev",
    "dev:prod": "run-p webpack:watch hugo:dev:prod",
    "dev:static": "run-p webpack:watch hugo:dev:static",
    "build": "rm -rf public && npm ci && run-s webpack:build hugo:build",
    "build:debug": "rm -rf public && npm ci && run-s webpack:build hugo:build:debug",
    "hugo:build": "hugo -b https://docs.mekodata.ai",
    "hugo:build:debug": "hugo --templateMetrics --templateMetricsHints -b https://docs.mekodata.ai",
    "hugo:dev": "hugo server --bind 0.0.0.0 --baseURL ${MEKO_HUGO_BASE:-localhost}",
    "hugo:dev:prod": "hugo server --bind 0.0.0.0 --baseURL ${MEKO_HUGO_BASE:-localhost} --environment production",
    "hugo:dev:static": "hugo server --renderStaticToDisk --bind 0.0.0.0 --baseURL ${MEKO_HUGO_BASE:-localhost}",
    "webpack:build": "webpack --mode=production",
    "webpack:watch": "webpack --mode=production --watch"
  },
  "author": "YugabyteDB, Inc.",
  "license": "Apache License 2.0",
  "homepage": "https://github.com/yugabyte/meko/tree/master/docs#readme",
  "dependencies": {
    "@babel/core": "7.29.0",
    "@babel/plugin-proposal-decorators": "7.29.0",
    "@babel/preset-env": "7.29.2",
    "@eslint/js": "9.39.2",
    "@stylistic/eslint-plugin": "5.10.0",
    "babel-loader": "10.1.1",
    "browser-cookie-utils": "2.0.1",
    "browser-query-utils": "2.0.1",
    "clipboard": "2.0.11",
    "detect-external-link": "2.0.1",
    "eslint": "9.39.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-webpack-plugin": "5.0.2",
    "globals": "17.4.0",
    "sass": "1.98.0",
    "webpack": "5.105.4",
    "webpack-cli": "7.0.2",
    "webpack-dev-server": "5.2.3"
  },
  "devDependencies": {
    "autoprefixer": "10.4.27",
    "npm-run-all": "4.1.5",
    "postcss": "8.5.8",
    "postcss-cli": "11.0.1"
  }
}
