PORT=3011

# Feature flags (runtime; served to the client via /runtime-config.js)
# Show the AMP controller registration section. Off unless "true".
SHOW_AMP_ADMIN=false

# YugabyteDB connection (YSQL)
YUGABYTEDB_HOST=127.0.0.1
YUGABYTEDB_PORT=5433
YUGABYTEDB_USER=yugabyte
YUGABYTEDB_PASSWORD=yugabyte
YUGABYTEDB_DB=yugabyte

# TLS/SSL — set YUGABYTEDB_SSL=true for clusters with TLS enabled
YUGABYTEDB_SSL=false
# Set to false when using self-signed certificates
YUGABYTEDB_SSL_REJECT_UNAUTHORIZED=true
# Optional: path to CA certificate file (PEM format)
# YUGABYTEDB_SSL_CA_CERT=/path/to/ca.crt

# AWS credentials (uses default credential chain if unset)
AWS_REGION=us-east-2
COGNITO_USER_POOL_ID=us-east-2_XXXXXX

# Admin Cognito user pool (dedicated pool for admin users only)
ADMIN_COGNITO_POOL_ID=us-east-2_XXXXXXXX
# App client with USER_PASSWORD_AUTH flow enabled, no client secret
ADMIN_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Only needed if the app client has a client secret configured
ADMIN_COGNITO_CLIENT_SECRET=

# api_server — usage metrics are proxied from it (it owns the multi-DB queries).
# ADMIN_API_KEY must match api_server's --admin-api-key / ADMIN_API_KEY.
MEKO_API_URL=http://localhost:25433
ADMIN_API_KEY=dev-admin-secret
