# Copy to docs/docker/.env (gitignored) and fill in values from the Kapa dashboard.
# docker compose up reads this file automatically when launched from docs/docker/.
#
# Get these from https://app.kapa.ai — API Keys tab for the API key, Projects
# tab for the project ID, Integrations tab for the integration ID.

KAPA_API_KEY=
KAPA_PROJECT_ID=
# Optional: scope analytics/telemetry to a specific widget/integration. Not required for basic chat.
# Must be a "Custom (via API)" integration ID — widget-type integration IDs are not valid for HTTP API requests.
KAPA_INTEGRATION_ID=
# Optional: comma-separated source group IDs to restrict answers to. Left empty,
# the project answers from every source it has indexed.
KAPA_SOURCE_GROUP_IDS=
