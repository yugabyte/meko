//! SLRU (clog) trim reclamation: every write-commit stamps a SETBIT
//! delta on the active `pg_xact` (clog) SLRU page, so a burst of tiny
//! txns piles deltas onto one block. The materialiser periodically
//! images that block (a fresh `will_init` anchor), and the drain then
//! trims the deltas below the anchor (`gc_kind = trim_slru`). Asserts the
//! busiest clog block's version count is *reclaimed* — it settles well
//! below its churn peak — rather than growing one row per commit.
//!
//! NOTE: this is timing-dependent on the background materialiser imaging
//! the clog page; the assertion is a heuristic (peak vs settled), not an
//! exact count. If it never settles it `bail!`s with the observed numbers
//! — which would itself be a finding (SLRU trim not reclaiming). Dedicated
//! branch so the clog signal is this test's alone.
//!
//! DISABLED pending #420 — this file is `.rs.disabled`, so `build.rs`
//! neither compiles nor registers it. The materialiser fatal-aborts
//! imaging a branched clog page whose base is on the ancestor, so SLRU
//! trim can't be exercised on a branch yet. The body is written for the
//! fixed world; re-enable once #420 lands with:
//!   git mv …/gc_slru_trim_reclaims.rs.disabled …/gc_slru_trim_reclaims.rs

use std::time::Duration;

use anyhow::bail;
use tokio::time::sleep;

use crate::cluster::{Cluster, step};
use crate::db;

const COMMITS: i64 = 3000;

pub async fn run(c: &Cluster) -> anyhow::Result<()> {
    let branch_pg_port = c.compute_port() + 260;
    let yb = db::yb_conn(c.yb_host(), c.yb_port(), c.db_name());

    step("Dedicated branch + endpoint");
    let b = c.branch_create_named("gc_st", "main")?;
    c.endpoint_create_on_branch("ep_gc_st", "gc_st", branch_pg_port)?;
    let conn = db::compute_conn(branch_pg_port);

    step("Churn many committed txns so the active clog page piles up deltas");
    // A server-side loop that COMMITs per row: one clog SETBIT delta each.
    // (COMMIT can't run inside the implicit txn of a multi-statement batch,
    // so the procedure body + the CALL go in separate batches.)
    db::batch(&conn, "CREATE TABLE gc_st (id BIGINT)").await?;
    db::batch(
        &conn,
        "CREATE PROCEDURE gc_st_churn(n INT) LANGUAGE plpgsql AS $$
         BEGIN FOR i IN 1..n LOOP INSERT INTO gc_st VALUES (i); COMMIT; END LOOP; END $$;",
    )
    .await?;
    db::batch(&conn, &format!("CALL gc_st_churn({COMMITS})")).await?;
    db::batch(&conn, "CHECKPOINT").await?;

    // The busiest clog block's version count (kind=0 = Clog).
    let hot_block = format!(
        "SELECT COALESCE(max(c), 0) FROM \
           (SELECT count(*) c FROM amp_storage.slru_pages \
            WHERE branch_id = '{b}' AND kind = 0 GROUP BY blknum) t"
    );
    let peak = db::query_i64(&yb, &hot_block).await?;
    if peak < COMMITS / 2 {
        bail!("expected the clog churn to pile up ~{COMMITS} deltas on a block, saw peak {peak}");
    }

    step("Keep the WAL frontier moving; the drain trims the clog deltas below the anchor");
    let mut settled = peak;
    for i in 0..40 {
        // Advance the cutoff (a side table so gc_st's own pages stay put),
        // and nudge the materialiser with a checkpoint.
        db::batch(
            &conn,
            &format!(
                "CREATE TABLE IF NOT EXISTS gc_st_churn_side (id INT PRIMARY KEY, n INT);
                 INSERT INTO gc_st_churn_side VALUES ({i}, {i});
                 CHECKPOINT;"
            ),
        )
        .await?;
        sleep(Duration::from_secs(1)).await;
        settled = db::query_i64(&yb, &hot_block).await?;
        // Trim reclaimed a meaningful share of the churned deltas.
        if settled < peak / 2 {
            break;
        }
    }

    let _ = c.yb(&["branch", "drop", "--branch-id", &b]);
    c.yb_quiet(&["pageserver", "stop", "ep_gc_st", "-m", "immediate"]);
    if settled >= peak / 2 {
        bail!(
            "clog trim did not reclaim: busiest block held {peak} versions at peak, \
             still {settled} after 40s of drain (materialiser imaging the clog page?)"
        );
    }
    Ok(())
}
